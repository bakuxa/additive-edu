<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Главная | Аддитивные технологии</title>
    <link rel="stylesheet" href="/css/index.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body>
   <div class="page-container">
    
    <div class="logo">
        <img src="/img/logo.png" alt="Логотип">
    </div>
    
   <div class="auth-buttons">
        <a href="/Home/Register" class="register-link">Зарегистрироваться</a>
        <a href="/Home/Login" class="login-link">Войти</a>
    </div>

    <div class="auth-vector">
        <img src="/img/vector_index.png" alt="vector">
    </div>
    
    <div class="content">
        <div class="hero-title">
            Прокачай свой уровень <br>
            в <span class="gradient-text">аддитивных<br> технологиях</span>
        </div>
        
        <div class="hero-subtitle">
            Интерактивная платформа с теорией, симуляторами и геймификацией. Создана для студентов «Политехника» и будущих инженеров.
        </div>
        
        <div class="hero-card">
            <div class="hero-text">
                От теории – к осознанной практике!
            </div>
            <button class="start-btn">Начать обучение</button>
        </div>
    </div>

    <div class="images-block">
        <div class="image-1">
            <img src="/img/photo2.png" alt="3D печать 1">
        </div>
        <div class="image-2">
            <img src="/img/photo3.png" alt="3D печать 2">
        </div>
        <div class="image-3">
            <img src="/img/photo4.png" alt="3D печать 3">
        </div>
    </div>

    <!-- Блок преимуществ -->
    <div class="advantages-section">
        <h2 class="advantages-title">Преимущества<br>обучения</h2>
        <div class="title-line"></div>
        <div class="advantages-quote">
            <p>Современный подход к изучению аддитивных технологий, который объединяет теорию, практику и игровые механики для максимальной эффективности.</p>
        </div>
    </div>

    <!-- Элементы в шахматном порядке -->
    <div class="chess-block">
        <div class="chess-column-left">
            <div class="chess-left">
                <span>Доступ 24/7</span>
            </div>
            <div class="chess-left">
                <span>Адаптивное тестирование</span>
            </div>
            <div class="chess-left">
                <span>Сравнение технологий</span>
            </div>
        </div>
        
        <div class="chess-column-right">
            <div class="chess-right">
                <span>Автоматическая проверка</span>
            </div>
            <div class="chess-right">
                <span>Образовательные квесты</span>
            </div>
            <div class="chess-right">
                <span>Система уровней и достижений</span>
            </div>
        </div>
    </div>
    <!-- Блок "Для кого полезно?" -->
    <div class="useful-section">
        <div class="useful-image">
            <img src="/img/photo5.png" alt="Для кого полезно">
        </div>
        <div class="useful-content">
            <h2 class="useful-title">Для кого полезно?</h2>
            <div class="useful-text">
                <p>Студенты технических специальностей получат практические навыки работы с 3D-печатью и смогут закрепить теорию с помощью интерактивных заданий.</p>
                <p class="useful-text-second">Преподаватели смогут отслеживать прогресс студентов и использовать платформу как дополнительный образовательный инструмент.</p>
            </div>
        </div>
    </div>
    <!-- Блок сферы применения -->
    <div class="applications-section">
        <h2 class="applications-title">Сферы применения</h2>
        <div class="applications-grid">
            <div class="app-row">
                <button class="app-btn">Машиностроение</button>
                <button class="app-btn">Медицина</button>
                <button class="app-btn">Авиация</button>
            </div>
            <div class="app-row">
                <button class="app-btn">Строительство</button>
                <button class="app-btn">Образование</button>
            </div>
        </div>
    </div>
    <div class="bg-vector">
        <img src="/img/vector_index2.png" alt="фон">
    </div>
<!-- Блок программы обучения с курсами -->
<div class="program-courses-wrapper">
    
    <!-- Левая часть: Программа обучения -->
    <div class="program-left">
        <h2 class="program-title">Программа<br>обучения</h2>
        <div class="program-line"></div>
        <div class="program-quote">
            <p>Изучите современные аддитивные технологии с нуля до профессионального уровня. Практические задания, симуляторы и квесты ждут вас!</p>
        </div>
    </div>
    
    <!-- Правая часть: Курсы (динамические) -->
    <div class="courses-right" id="coursesContainer">
        <div class="loading-courses">Загрузка программы обучения...</div>
    </div>
</div>
</div>

    <script>
        function createDotOrnament() {
            const ornament = document.createElement('div');
            ornament.className = 'dot-ornament';
            
            // Создаем 100 точек (10x10)
            for (let i = 0; i < 100; i++) {
                const dot = document.createElement('div');
                dot.className = 'dot';
                ornament.appendChild(dot);
            }
            
            // Вставляем после hero-card
            const heroCard = document.querySelector('.hero-card');
            heroCard.insertAdjacentElement('afterend', ornament);
        }
        
        createDotOrnament();
    </script>

    <script>
        // Функция для создания раскрывающихся блоков
        function initCourseAccordion() {
            const expandButtons = document.querySelectorAll('.course-expand');
            
            // Для каждого курса добавляем раскрывающийся блок один раз
            expandButtons.forEach((button, index) => {
                const courseCard = button.closest('.course-card');
                
                // Создаем блок с раскрывающимся контентом один раз
                const expandableContent = document.createElement('div');
                expandableContent.className = 'course-expandable-content';
                expandableContent.innerHTML = `
                    <div class="expandable-inner">
                        <h4>Содержание курса:</h4>
                        <ul>
                            <li>Введение в тему</li>
                            <li>Основные понятия и термины</li>
                            <li>Практические задания</li>
                            <li>Итоговое тестирование</li>
                        </ul>
                        <p>После завершения курса вы получите сертификат.</p>
                    </div>
                `;
                
                // Вставляем блок после course-card
                courseCard.insertAdjacentElement('afterend', expandableContent);
                
                // Скрываем блок по умолчанию
                expandableContent.style.display = 'none';
                
                // Добавляем обработчик клика
                button.addEventListener('click', function() {
                    // Проверяем текущее состояние блока
                    const isVisible = expandableContent.style.display === 'block';
                    
                    if (isVisible) {
                        // Скрываем блок
                        expandableContent.style.display = 'none';
                        // Возвращаем кнопку в исходное положение
                        this.style.transform = 'rotate(0deg)';
                    } else {
                        // Показываем блок
                        expandableContent.style.display = 'block';
                        // Поворачиваем кнопку на 45 градусов
                        this.style.transform = 'rotate(45deg)';
                    }
                });
            });
        }
        
        // Запускаем функцию после загрузки страницы
        document.addEventListener('DOMContentLoaded', initCourseAccordion);
    </script>

<script>
    function initMobileLayout() {
        if (window.innerWidth <= 480 && window.innerHeight <= 700) {
            const content = document.querySelector('.content');
            if (content && !document.querySelector('.mobile-hero')) {
                // Получаем элементы
                const heroTitle = document.querySelector('.hero-title');
                const heroCard = document.querySelector('.hero-card');
                const image1 = document.querySelector('.image-1');
                
                if (heroTitle && heroCard && image1) {
                    // Создаём контейнер для картинки и заголовка
                    const mobileHero = document.createElement('div');
                    mobileHero.className = 'mobile-hero';
                    
                    const imageBlock = document.createElement('div');
                    imageBlock.className = 'mobile-hero-image';
                    const imgClone = image1.querySelector('img').cloneNode(true);
                    imageBlock.appendChild(imgClone);
                    
                    const titleClone = heroTitle.cloneNode(true);
                    
                    mobileHero.appendChild(imageBlock);
                    mobileHero.appendChild(titleClone);
                    
                    heroTitle.style.display = 'none';
                    image1.style.display = 'none';
                    
                    content.insertBefore(mobileHero, heroCard);
                }
            }
        }
    }
    
    document.addEventListener('DOMContentLoaded', initMobileLayout);

    // Загрузка курсов из БД
    async function loadCourses() {
        const container = document.getElementById('coursesContainer');
        if (!container) return;
        
        try {
            const response = await fetch('/Home/GetCourses');
            const modules = await response.json();
            
            if (!modules || modules.length === 0) {
                container.innerHTML = '<div class="empty-courses">Курсы скоро появятся...</div>';
                return;
            }
            
            let html = '';
            for (let i = 0; i < modules.length; i++) {
                const module = modules[i];
                const numberStr = module.number.toString().padStart(2, '0');
                const lessonsText = getLessonsText(module.lessonsCount, module.tasksCount);
                
                html += `
                    <div class="course-card" data-module-id="${module.id}">
                        <div class="course-left">
                            <span class="course-number">${numberStr}</span>
                            <div class="course-info">
                                <h3 class="course-title">${escapeHtml(module.title)}</h3>
                                <span class="course-lessons">${lessonsText}</span>
                            </div>
                        </div>
                        <div class="course-right">
                            <button class="course-expand" data-module-id="${module.id}">+</button>
                        </div>
                    </div>
                    <div class="course-line"></div>
                `;
            }
            
            container.innerHTML = html;
            
            initCourseAccordion();
            
        } catch (error) {
            console.error('Ошибка загрузки курсов:', error);
            container.innerHTML = '<div class="error-courses">Не удалось загрузить программу обучения</div>';
        }
    }

    function getLessonsText(lessonsCount, tasksCount) {
        const lessonsWord = getDeclension(lessonsCount, 'урок', 'урока', 'уроков');
        const tasksWord = getDeclension(tasksCount, 'задание', 'задания', 'заданий');
        return `${lessonsCount} ${lessonsWord}, ${tasksCount} ${tasksWord}`;
    }

    function getDeclension(number, one, two, five) {
        const n = Math.abs(number) % 100;
        const n1 = n % 10;
        if (n > 10 && n < 20) return five;
        if (n1 > 1 && n1 < 5) return two;
        if (n1 === 1) return one;
        return five;
    }

    function escapeHtml(str) {
        if (!str) return '';
        return str.replace(/[&<>]/g, function(m) {
            if (m === '&') return '&amp;';
            if (m === '<') return '&lt;';
            if (m === '>') return '&gt;';
            return m;
        });
    }

    function initCourseAccordion() {
        const expandButtons = document.querySelectorAll('.course-expand');
        
        expandButtons.forEach((button) => {
            const courseCard = button.closest('.course-card');
            const moduleId = button.dataset.moduleId;
            
            let expandableContent = courseCard.nextElementSibling;
            if (expandableContent && expandableContent.classList.contains('course-expandable-content')) {

                const newButton = button.cloneNode(true);
                button.parentNode.replaceChild(newButton, button);
                button = newButton;
                expandableContent = courseCard.nextElementSibling;
            } else {
                expandableContent = document.createElement('div');
                expandableContent.className = 'course-expandable-content';
                expandableContent.innerHTML = `
                    <div class="expandable-inner">
                        <div class="loading-lessons">Загрузка содержания...</div>
                    </div>
                `;
                courseCard.insertAdjacentElement('afterend', expandableContent);
                expandableContent.style.display = 'none';
            }
            
            button.addEventListener('click', async function() {
                const isVisible = expandableContent.style.display === 'block';
                
                if (isVisible) {
                    expandableContent.style.display = 'none';
                    this.style.transform = 'rotate(0deg)';
                } else {

                    if (expandableContent.querySelector('.loading-lessons')) {
                        await loadModuleLessons(moduleId, expandableContent);
                    }
                    expandableContent.style.display = 'block';
                    this.style.transform = 'rotate(45deg)';
                }
            });
        });
    }

    async function loadModuleLessons(moduleId, container) {
        try {
            const response = await fetch(`/api/courses/module/${moduleId}/lessons`);
            const lessons = await response.json();
            
            if (!lessons || lessons.length === 0) {
                container.querySelector('.expandable-inner').innerHTML = `
                    <h4>Содержание модуля:</h4>
                    <p>В этом модуле пока нет уроков.</p>
                `;
                return;
            }
            
            let lessonsHtml = '<h4>Уроки модуля:</h4><ul>';
            for (const lesson of lessons) {
                lessonsHtml += `<li> ${escapeHtml(lesson.lessonTitle)}</li>`;
            }
            lessonsHtml += '</ul>';
            
            container.querySelector('.expandable-inner').innerHTML = lessonsHtml;
            
        } catch (error) {
            console.error('Ошибка загрузки уроков:', error);
            container.querySelector('.expandable-inner').innerHTML = `
                <h4>Содержание модуля:</h4>
                <p class="error-text">Не удалось загрузить уроки</p>
            `;
        }
    }

    // Запускаем загрузку курсов после загрузки страницы
    document.addEventListener('DOMContentLoaded', function() {
        loadCourses();
    });
</script>
</body>
</html>