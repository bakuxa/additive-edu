        async function loadLesson() {
            const user = loadUserData();
            if (!user) return;

            const container = document.getElementById('lessonContent');

            try {
                const progressResponse = await fetch(`/api/lesson/is-completed/${lessonId}/${user.userId}`);
                const progressData = await progressResponse.json();
                const isLessonCompleted = progressData.isCompleted;
                
                const lessonResponse = await fetch(`/api/lesson/${lessonId}`);
                if (!lessonResponse.ok) throw new Error('Ошибка загрузки урока');
                const lesson = await lessonResponse.json();
                
                const moduleTitle = lesson.module?.moduleTitle || 'Модуль';
                const moduleNumber = lesson.module?.moduleNumber || '?';
                
                document.getElementById('pageTitle').textContent = lesson.lessonTitle;

                if (isLessonCompleted) {
                    renderCompletedLesson(lesson, moduleNumber, moduleTitle);
                } else {
                    const tasksResponse = await fetch(`/api/lesson/${lessonId}/tasks`);
                    tasks = await tasksResponse.json();
                    
                    const completedTasks = await getCompletedTasks(user.userId, tasks.map(t => t.taskID));
                    
                    let nextTaskIndex = -1;
                    for (let i = 0; i < tasks.length; i++) {
                        if (!completedTasks.has(tasks[i].taskID)) {
                            nextTaskIndex = i;
                            break;
                        }
                    }
                    
                    if (nextTaskIndex === -1) {
                        await markLessonAsCompleted(user.userId, lessonId);
                        renderCompletedLesson(lesson, moduleNumber, moduleTitle);
                        return;
                    }
                    
                    currentTaskId = tasks[nextTaskIndex].taskID;
                    const currentTask = tasks[nextTaskIndex];
                    
                    if (currentTask.typeName === 'Сопоставление') {
                        renderMatchLesson(lesson, moduleNumber, moduleTitle);
                        await loadMatchTask(currentTaskId);
                    } else if (currentTask.typeName === 'Квест') {
                        renderQuestLesson(lesson, moduleNumber, moduleTitle);
                        await loadQuestTask(currentTaskId);
                    } else {
                        await renderTestLesson(lesson, moduleNumber, moduleTitle);
                    }
                }
            } catch (error) {
                console.error('Ошибка:', error);
                container.innerHTML = `<div class="error-message">⚠️ Ошибка загрузки урока: ${error.message}</div>`;
            }
        }

        async function getCompletedTasks(userId, taskIds) {
            const completed = new Set();
            try {
                for (const taskId of taskIds) {
                    const response = await fetch(`/api/lesson/task/${taskId}/is-completed/${userId}`);
                    if (response.ok) {
                        const data = await response.json();
                        if (data.isCompleted) completed.add(taskId);
                    }
                }
            } catch (error) {
                console.error('Ошибка проверки заданий:', error);
            }
            return completed;
        }

