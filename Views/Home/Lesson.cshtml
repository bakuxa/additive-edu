        function selectAnswer(element, questionId, answerId) {
            const questionDiv = element.closest('.question-item');
            questionDiv.querySelectorAll('.answer-option').forEach(opt => opt.classList.remove('selected'));
            element.classList.add('selected');
            userAnswers[questionId] = answerId;
        }

        async function finishTest() {
            const user = loadUserData();
            if (!user) return;
            
            const unanswered = allQuestions.filter(q => !userAnswers[q.questionID]);
            if (unanswered.length > 0) {
                alert(`Ответьте на все вопросы! Осталось ${unanswered.length}`);
                return;
            }
            
            const finishBtn = document.getElementById('finishTestBtn');
            finishBtn.disabled = true;
            finishBtn.textContent = '⏳ Проверка...';
            
            const answers = allQuestions.map(q => ({
                questionId: q.questionID,
                selectedAnswerId: userAnswers[q.questionID]
            }));
            
            try {
                const response = await fetch('/api/lesson/submit-test', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        userId: user.userId,
                        lessonId: lessonId,
                        taskId: currentTaskId,
                        answers: answers
                    })
                });
                const result = await response.json();
                
                if (result.success) {
                    allQuestions.forEach(question => {
                        const correct = question.answers.find(a => a.isCorrect);
                        const selected = userAnswers[question.questionID];
                        const div = document.querySelector(`.question-item[data-question-id="${question.questionID}"]`);
                        if (div) {
                            div.querySelectorAll('.answer-option').forEach(opt => {
                                opt.style.pointerEvents = 'none';
                                const aid = parseInt(opt.dataset.answerId);
                                if (aid === correct?.answerID) opt.classList.add('correct-highlight');
                                if (aid === selected && aid !== correct?.answerID) opt.classList.add('wrong-highlight');
                            });
                            const msgDiv = div.querySelector('.result-message');
                            msgDiv.style.display = 'block';
                            if (selected === correct?.answerID) {
                                msgDiv.innerHTML = '✓ Правильно!';
                                msgDiv.className = 'result-message correct';
                            } else {
                                msgDiv.innerHTML = `✗ Неправильно!<br><span style="font-size:12px;">Правильный ответ: ${escapeHtml(correct?.answerText)}</span>`;
                                msgDiv.className = 'result-message incorrect';
                            }
                        }
                    });
                    
                    finishBtn.textContent = '📚 Продолжить';
                    finishBtn.disabled = false;
                    
                    const currentIdx = tasks.findIndex(t => t.taskID === currentTaskId);
                    const isLast = (currentIdx === tasks.length - 1);
                    
                    finishBtn.onclick = () => {
                        if (isLast) {
                            window.location.href = '/Home/Courses';
                        } else {
                            window.location.reload();
                        }
                    };
                    
                    showResultModal(result.totalScore, result.maxScore, result.xpGained);
                    
                    const u = JSON.parse(localStorage.getItem('user'));
                    if (u) {
                        u.experience = result.newTotalXp;
                        u.level = result.newLevel;
                        localStorage.setItem('user', JSON.stringify(u));
                    }
                } else {
                    finishBtn.disabled = false;
                    finishBtn.textContent = '✅ Завершить тест';
                    alert('Ошибка при сохранении результатов');
                }
            } catch (error) {
                console.error('Ошибка:', error);
                alert('Ошибка: ' + error.message);
                finishBtn.disabled = false;
                finishBtn.textContent = '✅ Завершить тест';
            }
        }

