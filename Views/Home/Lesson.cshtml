        }

        function renderMatchInterface() {
            const container = document.getElementById('matchContainer');
            if (!container) return;
            
            const rightNumbered = matchData.rightItems.map((item, idx) => ({ number: idx + 1, text: item }));
            
            container.innerHTML = `
                <div class="match-container">
                    <div class="match-column">
                        <h3>Термин</h3>
                        ${matchData.leftItems.map((item, idx) => `
                            <div class="match-left-item">
                                <div class="match-left-text">${escapeHtml(item)}</div>
                                <div class="custom-select-match" data-left-idx="${idx}">
                                    <div class="custom-select-match-trigger" onclick="toggleMatchSelect(${idx})">
                                        <span id="match-selected-${idx}">Выберите</span>
                                        <div class="custom-select-match-arrow"></div>
                                    </div>
                                    <div class="custom-select-match-dropdown" id="match-dropdown-${idx}">
                                        <div class="custom-select-match-option" data-value="" onclick="selectMatchOption(${idx}, '', '— Выберите —')">— Выберите —</div>
                                        ${rightNumbered.map(opt => `
                                            <div class="custom-select-match-option" data-value="${opt.number}" onclick="selectMatchOption(${idx}, ${opt.number}, '${opt.number}')">
                                                ${opt.number}
                                            </div>
                                        `).join('')}
                                    </div>
                                </div>
                            </div>
                        `).join('')}
                    </div>
                    <div class="match-column">
                        <h3>Определение</h3>
                        ${rightNumbered.map(item => `
                            <div class="match-right-item">
                                <div class="match-right-text"><span class="match-right-number">${item.number}</span> ${escapeHtml(item.text)}</div>
                            </div>
                        `).join('')}
                    </div>
                </div>
            `;
        }

        window.toggleMatchSelect = function(leftIdx) {
            document.querySelectorAll('.custom-select-match').forEach(select => {
                if (parseInt(select.dataset.leftIdx) !== leftIdx) {
                    select.classList.remove('open');
                }
            });
            const selectDiv = document.querySelector(`.custom-select-match[data-left-idx="${leftIdx}"]`);
            selectDiv.classList.toggle('open');
        };

        window.selectMatchOption = function(leftIdx, value, displayText) {
            userMatches[leftIdx] = value ? parseInt(value) : null;
            const triggerSpan = document.getElementById(`match-selected-${leftIdx}`);
            triggerSpan.textContent = displayText;
            const selectDiv = document.querySelector(`.custom-select-match[data-left-idx="${leftIdx}"]`);
            selectDiv.classList.remove('open');
            selectDiv.classList.remove('correct', 'wrong');
        };

        document.addEventListener('click', function(e) {
            if (!e.target.closest('.custom-select-match')) {
                document.querySelectorAll('.custom-select-match').forEach(select => {
                    select.classList.remove('open');
                });
            }
        });

        async function checkMatchAnswers() {
            const allSelected = Object.values(userMatches).every(v => v !== null && v !== '');
            if (!allSelected) { alert('Выберите соответствия для всех терминов!'); return; }
            
            let correct = 0;
            for (const m of matchData.correctMatches) {
                if (userMatches[m.left] === m.right + 1) correct++;
            }
            const score = Math.round((correct / matchData.leftItems.length) * 100);
            
            const user = loadUserData();
            
            try {
                await fetch('/api/lesson/submit-match-result', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ userId: user.userId, lessonId: lessonId, taskId: currentTaskId, score: score })
                });
            } catch (error) {
                console.error('Ошибка сохранения:', error);
            }
            
            for (const m of matchData.correctMatches) {
                const selectDiv = document.querySelector(`.custom-select-match[data-left-idx="${m.left}"]`);
                if (selectDiv) {
                    const isCorrect = (userMatches[m.left] === m.right + 1);
                    if (isCorrect) {
                        selectDiv.classList.add('correct');
                    } else {
                        selectDiv.classList.add('wrong');
                    }
                    const trigger = selectDiv.querySelector('.custom-select-match-trigger');
                    trigger.style.pointerEvents = 'none';
                }
            }
            
            const currentIdx = tasks.findIndex(t => t.taskID === currentTaskId);
            const isLast = (currentIdx === tasks.length - 1);
            
            const checkBtn = document.getElementById('checkMatchBtn');
            if (checkBtn) checkBtn.remove();
            
            const container = document.getElementById('matchContainer');
            container.innerHTML += `
                <div class="match-result">
                    <div class="match-score">${score} / 100</div>
                    <button class="finish-test-btn" id="continueBtn">Продолжить обучение</button>
                </div>
            `;
            
            const continueBtn = document.getElementById('continueBtn');
            continueBtn.onclick = function() {
                if (isLast) {
                    window.location.href = '/Home/Courses';
                } else {
                    window.location.reload();
                }
            };
            
            showResultModal(score, 100, score);
            
            const u = JSON.parse(localStorage.getItem('user'));
            if (u) {
                u.experience = (u.experience || 0) + score;
                u.level = Math.floor(u.experience / 100) + 1;
                localStorage.setItem('user', JSON.stringify(u));
            }
        }

        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
        }

        // Модалка
        document.getElementById('modalContinueBtn')?.addEventListener('click', () => {
            document.getElementById('resultModal').classList.remove('active');
        });
        document.getElementById('modalCloseBtn')?.addEventListener('click', () => {
            document.getElementById('resultModal').classList.remove('active');
        });

        // Навигация
        document.getElementById('profileNav')?.addEventListener('click', () => window.location.href = '/Home/Profile');
        document.getElementById('coursesNav')?.addEventListener('click', () => window.location.href = '/Home/Courses');
        document.getElementById('achievementsNav')?.addEventListener('click', () => window.location.href = '/Home/Achievements');
        document.getElementById('ratingNav')?.addEventListener('click', () => window.location.href = '/Home/Rating');
        document.getElementById('logoutBtn')?.addEventListener('click', () => {
            localStorage.removeItem('user');
            window.location.href = '/Home/Index';
        });

        loadLesson();
    </script>
</body>
</html>