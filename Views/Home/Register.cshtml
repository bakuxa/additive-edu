<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Регистрация | Аддитивные технологии</title>
    <link rel="stylesheet" href="/css/register.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        /* ========== МОДАЛЬНОЕ ОКНО ========== */
.modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10000;
}

.modal-content {
    background: #FFFFFF;
    border-radius: 24px;
    padding: 30px 40px;
    text-align: center;
    border: 2px solid #029FA4;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
    min-width: 320px;
    max-width: 400px;
    animation: modalFadeIn 0.3s ease-out;
}

.modal-message {
    font-family: 'Poppins', sans-serif;
    font-size: 18px;
    color: #21383E;
    margin-bottom: 25px;
    line-height: 1.4;
}

.modal-ok-btn {
    background: linear-gradient(135deg, #029FA4, #8ED1D1);
    color: white;
    border: none;
    padding: 10px 35px;
    border-radius: 30px;
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    font-size: 14px;
    cursor: pointer;
    transition: all 0.2s ease;
}

.modal-ok-btn:hover {
    transform: scale(1.05);
    opacity: 0.9;
}
    </style>
</head>
<body>
    <div class="page-container">
        <div class="vector-bg"><img src="/img/Vector1.png" alt=""></div>
        <a href="/Home/Index" class="logo-link">
            <div class="logo">
                <img src="/img/logo.png" alt="Логотип">
            </div>
        </a>
        
        <div class="hero-text">
            Прокачай свой уровень в <span class="gradient-text">аддитивных технологиях</span>
        </div>
        
        <div class="main-image">
            <img src="/img/photo2.png" alt="3D печать">
            <div class="image-caption">
                <span>Станьте специалистом <br>в области 3D-печати</span>
            </div>
        </div>
    
        <div class="register-card">
            <h1 class="register-title">Регистрация</h1>
            <p class="register-subtitle">Создайте аккаунт, чтобы изучать теорию, проходить адаптивные тесты, работать с симуляторами и получать достижения</p>
            
            <div class="input-field">
                <label for="surname">Фамилия</label>
                <input type="text" id="surname" placeholder="Иванов">
            </div>
            <div class="input-field">
                <label for="name">Имя</label>
                <input type="text" id="name" placeholder="Иван">
            </div>
            <div class="input-field">
                <label for="patronymic">Отчество</label>
                <input type="text" id="patronymic" placeholder="Иванович">
            </div>
            <div class="input-field">
                <label for="group">Группа</label>
                <input type="text" id="group" placeholder="ЦИС-27">
            </div>
            <div class="input-field">
                <label for="email">Email</label>
                <input type="email" id="email" placeholder="example@mail.com">
            </div>
            <div class="input-field">
                <label for="phone">Телефон</label>
                <input type="tel" id="phone" placeholder="+7 (999) 123-45-67">
            </div>
            <div class="input-field">
                <label for="password">Пароль</label>
                <input type="password" id="password" placeholder="••••••••">
            </div>
            
            <button class="register-btn-main" id="registerBtn">Зарегистрироваться</button>
            
            <p class="login-prompt">Уже есть аккаунт? Вернитесь на страницу входа</p>
            <button class="login-btn" id="loginBtn">Войти в аккаунт</button>
        </div>
    </div>

    <script>
        function showModal(message, redirectUrl = null) {
            const oldModal = document.querySelector('.modal-overlay');
            if (oldModal) oldModal.remove();

            const overlay = document.createElement('div');
            overlay.className = 'modal-overlay';
            overlay.innerHTML = `
                <div class="modal-content">
                    <p class="modal-message">${message}</p>
                    <button class="modal-ok-btn" id="modalOkBtn">OK</button>
                </div>
            `;
            document.body.appendChild(overlay);

            document.getElementById('modalOkBtn').addEventListener('click', () => {
                overlay.remove();
                if (redirectUrl) {
                    window.location.href = redirectUrl;
                }
            });
        }

        // ОДИН обработчик для регистрации
        document.getElementById('registerBtn').addEventListener('click', async function() {
            console.log('Register button clicked');
            
            const formData = {
                lastName: document.getElementById('surname').value.trim(),
                firstName: document.getElementById('name').value.trim(),
                middleName: document.getElementById('patronymic').value.trim(),
                group: document.getElementById('group').value.trim(),
                email: document.getElementById('email').value.trim(),
                phone: document.getElementById('phone').value.trim(),
                password: document.getElementById('password').value
            };
            
            console.log('Form data:', formData);

            if (!formData.lastName || !formData.firstName || !formData.email || !formData.password) {
                showModal('Пожалуйста, заполните обязательные поля (Фамилия, Имя, Email, Пароль)');
                return;
            }

            if (formData.password.length < 6) {
                showModal('Пароль должен содержать не менее 6 символов');
                return;
            }

            try {
                console.log('Sending request...');
                const response = await fetch('/api/auth/register', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(formData)
                });
                
                console.log('Response status:', response.status);
                const result = await response.json();
                console.log('Response data:', result);

                if (response.ok) {
                    showModal('Регистрация успешна! Теперь вы можете войти', '/Home/Login');
                } else {
                    showModal(result.message || 'Ошибка при регистрации');
                }
            } catch (error) {
                console.error('Ошибка:', error);
                showModal('Произошла ошибка при подключении к серверу: ' + error.message);
            }
        });

        document.getElementById('loginBtn').addEventListener('click', function() {
            window.location.href = '/Home/Login';
        });
    </script>
</body>
</html>