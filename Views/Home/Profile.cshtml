<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Профиль | Аддитивные технологии</title>
    <link rel="stylesheet" href="/css/profile.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
    <div class="page-container">
        <!-- Фоновые векторы (только они с absolute) -->
        <div class="vector-bg vector-1">
            <img src="/img/vector-bg-1.png" alt="фон">
        </div>
        <div class="vector-bg vector-2">
            <img src="/img/vector-bg-2.png" alt="фон">
        </div>
        
        <!-- Боковое меню -->
        <aside class="sidebar">
            <div class="sidebar-active"></div>
            <div class="sidebar-header">
                <h2 class="menu-title">Меню</h2>
            </div>
            <nav class="sidebar-nav">
                <div class="nav-item active">
                    <img src="/Pages/img/icon/profile-icon.png" alt="Профиль" class="nav-icon">
                    <span>Профиль</span>
                </div>
                <div class="nav-item">
                    <img src="/Pages/img/icon/courses-icon.png" alt="Мои курсы" class="nav-icon">
                    <span>Мои курсы</span>
                </div>
                <div class="nav-item">
                    <img src="/Pages/img/icon/achievements-icon.png" alt="Достижения" class="nav-icon">
                    <span>Достижения</span>
                </div>
                <div class="nav-item">
                    <img src="/Pages/img/icon/rating-icon.png" alt="Рейтинг" class="nav-icon">
                    <span>Рейтинг</span>
                </div>
                <div class="nav-item">
                    <img src="/Pages/img/icon/logout-icon.png" alt="Выйти" class="nav-icon">
                    <span>Выйти</span>
                </div>
            </nav>
            <div class="sidebar-footer">
                <img src="/img/logo.png" alt="Логотип" class="footer-logo">
            </div>
        </aside>
        
        <!-- Основной контент -->
        <main class="main-content">
            <!-- Верхняя панель -->
            <div class="top-bar">
                <h1 class="page-title">Профиль пользователя</h1>
                <div class="notification-btn">
                    <img src="/Pages/img/icon/logout-icon2.png" alt="">
                </div>
            </div>
            
            <!-- Карточка профиля -->
            <div class="profile-card">
                <button class="edit-profile-btn">
                    <img src="/Pages/img/icon/edit-icon.png" alt="Редактировать профиль">
                </button>
                <div class="profile-avatar">
                    <img src="/Pages/img/photo_profile.png" alt="Аватар">
                </div>
                <div class="profile-info">
                    <h3 class="profile-name">Прохорова Николь Владимировна</h3>
                    
                    <div class="profile-details">
                        <div class="detail-row">
                            <span class="detail-label">Дата регистрации:</span>
                            <span class="detail-value">24 ноября 2022 г.</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Номер телефона:</span>
                            <span class="detail-value">+7 (921) 834-85-43</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Электронная почта:</span>
                            <span class="detail-value">number@gmail.com</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Пароль:</span>
                            <span class="detail-value">***********</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Статус:</span>
                            <span class="detail-value status-active">Активный</span>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Нижние карточки -->
<div class="stats-row">
    <!-- Текущие результаты (слева) -->
    <div class="current-results-card">
        <h3 class="results-title">Текущие результаты</h3>
        
        <div class="results-list">
            <!-- Результат 1: Опыт -->
            <div class="result-item">
                <div class="result-label">Опыт</div>
                <div class="result-progress">
                    <div class="progress-bar-fill" style="width: 70%;"></div>
                </div>
                <div class="result-percent">
                    <span class="current-value" data-current="1540">1540</span>
                    <span class="separator">/</span>
                    <span class="max-value" data-max="2000">2000</span>
                    <span class="unit">XP</span>
                </div>
            </div>
            
            <!-- Результат 2: Уровень -->
            <div class="result-item">
                <div class="result-label">Уровень</div>
                <div class="result-progress">
                    <div class="progress-bar-fill" style="width: 30%;"></div>
                </div>
                <div class="result-percent">
                    <span class="current-value" data-current="3">3</span>
                    <span class="separator">/</span>
                    <span class="max-value" data-max="10">10</span>
                </div>
            </div>
            
            <!-- Результат 3: Прогресс по курсу -->
            <div class="result-item">
                <div class="result-label">Прогресс по курсу</div>
                <div class="result-progress">
                    <div class="progress-bar-fill" style="width: 32%;"></div>
                </div>
                <div class="result-percent">
                    <span class="current-value" data-current="32">32</span>
                    <span class="separator">/</span>
                    <span class="max-value" data-max="100">100</span>
                    <span class="unit">%</span>
                </div>
            </div>
            
            <!-- Результат 4: Средний балл -->
            <div class="result-item">
                <div class="result-label">Средний балл</div>
                <div class="result-progress">
                    <div class="progress-bar-fill" style="width: 77%;"></div>
                </div>
                <div class="result-percent">
                    <span class="current-value" data-current="77">77</span>
                    <span class="separator">/</span>
                    <span class="max-value" data-max="100">100</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Достижения (справа) - теперь ОТДЕЛЬНЫЙ блок -->
    <div class="achievements-card">
        <h4 class="achievements-title">Достижения:</h4>
        <div class="achievements-list">
            <div class="achievement-item">
                <div class="achievement-info">
                    <span class="achievement-name">Начинающий</span>
                    <span class="achievement-value">30%</span>
                </div>
                <div class="achievement-progress">
                    <div class="progress-bar" style="width: 30%"></div>
                </div>
            </div>
            <div class="achievement-item">
                <div class="achievement-info">
                    <span class="achievement-name">Знаток</span>
                    <span class="achievement-value">60%</span>
                </div>
                <div class="achievement-progress">
                    <div class="progress-bar" style="width: 60%"></div>
                </div>
            </div>
            <div class="achievement-item">
                <div class="achievement-info">
                    <span class="achievement-name">Эксперт</span>
                    <span class="achievement-value">20%</span>
                </div>
                <div class="achievement-progress">
                    <div class="progress-bar" style="width: 20%"></div>
                </div>
            </div>
        </div>
    </div>
</div>
        </main>
    </div>
</body>
</html>