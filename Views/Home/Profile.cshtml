<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Профиль | Аддитивные технологии</title>
    <link rel="stylesheet" href="/css/profile.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
    <div class="page-container">
        <div class="vector-bg vector-1">
            <img src="/img/vector-bg-1.png" alt="фон">
        </div>
        <div class="vector-bg vector-2">
            <img src="/img/vector-bg-2.png" alt="фон">
        </div>
        
        <aside class="sidebar">
            <div class="sidebar-active"></div>
            <div class="sidebar-header">
                <h2 class="menu-title">Меню</h2>
            </div>
            <nav class="sidebar-nav">
                <div class="nav-item active">
                    <img src="/img/icon/profile-icon.png" alt="Профиль" class="nav-icon">
                    <span>Профиль</span>
                </div>
                <div class="nav-item">
                    <img src="/img/icon/courses-icon.png" alt="Мои курсы" class="nav-icon">
                    <span>Мои курсы</span>
                </div>
                <div class="nav-item">
                    <img src="/img/icon/achievements-icon.png" alt="Достижения" class="nav-icon">
                    <span>Достижения</span>
                </div>
                <div class="nav-item">
                    <img src="/img/icon/rating-icon.png" alt="Рейтинг" class="nav-icon">
                    <span>Рейтинг</span>
                </div>
                <div class="nav-item" id="logoutBtn">
                    <img src="/img/icon/logout-icon.png" alt="Выйти" class="nav-icon">
                    <span>Выйти</span>
                </div>
            </nav>
            <div class="sidebar-footer">
                <img src="/img/logo.png" alt="Логотип" class="footer-logo">
            </div>
        </aside>
        
        <main class="main-content">
            <div class="top-bar">
                <h1 class="page-title">Профиль пользователя</h1>
                <div class="notification-btn" id="notificationBtn">
                    <img src="/img/icon/logout-icon2.png" alt="">
                </div>
            </div>
            
            <div class="profile-card">
                <button class="edit-profile-btn" id="editProfileBtn">
                    <img src="/img/icon/edit-icon.png" alt="Редактировать профиль">
                </button>
                <div class="profile-avatar">
                    <img id="avatarImg" src="/img/photo_profile.png" alt="Аватар">
                </div>
                <div class="profile-info">
                    <h3 class="profile-name" id="profileName"></h3>
                    <div class="profile-details" id="profileDetails"></div>
                    <div id="editActions" class="edit-actions" style="display: none;">
                        <button class="cancel-btn" id="cancelEditBtn">Отмена</button>
                        <button class="save-btn" id="saveProfileBtn">Сохранить</button>
                    </div>
                </div>
            </div>
            
            <!-- Объединенный блок статистики с 3 вертикальными ячейками -->
            <div class="unified-stats-card">
                <div class="stats-header">
                    <h3 class="stats-title-main">Моя статистика</h3>
                    <div class="level-badge" id="levelBadge">Уровень <span id="headerLevel">1</span></div>
                </div>
                
                <div class="stats-grid-unified">
                    <!-- Опыт -->
                    <div class="stat-card">
                        <div class="stat-icon">🌟</div>
                        <div class="stat-content">
                            <div class="stat-label">Опыт</div>
                            <div class="stat-value-large" id="expCurrent">0</div>
                            <div class="progress-wrapper">
                                <div class="progress-bar-unified">
                                    <div class="progress-fill" id="expProgressFill" style="width: 0%;"></div>
                                </div>
                                <div class="progress-labels">
                                    <span>0 XP</span>
                                    <span id="expMax">100 XP</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Прогресс по курсу -->
                    <div class="stat-card">
                        <div class="stat-icon">📚</div>
                        <div class="stat-content">
                            <div class="stat-label">Прогресс по курсу</div>
                            <div class="stat-value-large" id="courseCurrent">0<span class="small-unit">%</span></div>
                            <div class="progress-wrapper">
                                <div class="progress-bar-unified">
                                    <div class="progress-fill" id="courseProgressFill" style="width: 0%;"></div>
                                </div>
                                <div class="progress-labels">
                                    <span>0%</span>
                                    <span>100%</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Средний балл -->
                    <div class="stat-card">
                        <div class="stat-icon">📝</div>
                        <div class="stat-content">
                            <div class="stat-label">Средний балл</div>
                            <div class="stat-value-large" id="avgScoreCurrent">0<span class="small-unit">/100</span></div>
                            <div class="progress-wrapper">
                                <div class="progress-bar-unified">
                                    <div class="progress-fill" id="avgScoreFill" style="width: 0%;"></div>
                                </div>
                                <div class="progress-labels">
                                    <span>0</span>
                                    <span>100</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Новая строка с 3 вертикальными ячейками: достижения, XP, прогресс -->
                <div class="stats-grid-unified stats-grid-second">
                    <!-- Получено достижений -->
                    <div class="stat-card">
                        <div class="stat-icon">🏆</div>
                        <div class="stat-content">
                            <div class="stat-label">Получено достижений</div>
                            <div class="stat-value-large">
                                <span id="unlockedAchievements">0</span><span class="small-unit">/<span id="totalAchievements">0</span></span>
                            </div>
                            <div class="progress-wrapper">
                                <div class="progress-bar-unified">
                                    <div class="progress-fill" id="achievementsProgressFill" style="width: 0%;"></div>
                                </div>
                                <div class="progress-labels">
                                    <span>0%</span>
                                    <span>100%</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Всего XP за достижения -->
                    <div class="stat-card">
                        <div class="stat-icon">⭐</div>
                        <div class="stat-content">
                            <div class="stat-label">Всего XP за достижения</div>
                            <div class="stat-value-large" id="totalXp">0</div>
                            <div class="xp-bonus-text">
                                Бонусные очки за коллекционирование
                            </div>
                        </div>
                    </div>
                    
                    <!-- Прогресс коллекционирования -->
                    <div class="stat-card">
                        <div class="stat-icon">🎯</div>
                        <div class="stat-content">
                            <div class="stat-label">Прогресс коллекционирования</div>
                            <div class="stat-value-large" id="achievementsProgress">0<span class="small-unit">%</span></div>
                            <div class="progress-wrapper">
                                <div class="progress-bar-unified">
                                    <div class="progress-fill" id="collectionProgressFill" style="width: 0%;"></div>
                                </div>
                                <div class="progress-labels">
                                    <span>Начало</span>
                                    <span>Мастер</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Таблица недавних достижений -->
            <div class="recent-achievements-table">
                <div class="table-header">
                    <h4>Недавние достижения</h4>
                    <a href="/Home/Achievements" class="table-link">Все достижения →</a>
                </div>
                <div class="table-container" id="recentAchievementsTable">
                    <div class="loading-small">Загрузка...</div>
                </div>
            </div>
        </main>
    </div>

    <script>
        let currentUser = null;
        let isEditing = false;
        let originalUserData = null;

        function showModal(message) {
            const overlay = document.createElement('div');
            overlay.className = 'modal-overlay';
            overlay.innerHTML = `
                <div class="modal-content">
                    <p>${message}</p>
                    <button class="modal-ok-btn" id="modalOkBtn">OK</button>
                </div>
            `;
            document.body.appendChild(overlay);
            document.getElementById('modalOkBtn').addEventListener('click', () => {
                overlay.remove();
            });
        }

        function loadUserData() {
            const user = JSON.parse(localStorage.getItem('user'));
            if (!user) {
                window.location.href = '/Home/Login';
                return null;
            }
            return user;
        }

        function displayProfile(user, editMode = false, preserveOriginal = false) {
            if (!preserveOriginal && editMode) {
                originalUserData = JSON.parse(JSON.stringify(user));
            }
            
            let fullName = `${user.lastName} ${user.firstName}`;
            if (user.middleName) fullName += ` ${user.middleName}`;
            document.getElementById('profileName').textContent = fullName;
            
            const avatarImg = document.getElementById('avatarImg');
            if (avatarImg) {
                if (user.photoUrl && user.photoUrl !== '') {
                    avatarImg.src = user.photoUrl;
                } else {
                    avatarImg.src = '/img/no_photo_profile.png';
                }
            }
            
            const fields = [
                { label: 'Дата регистрации:', value: user.registrationDate || 'не указана', key: 'registrationDate', editable: false },
                { label: 'Номер телефона:', value: user.phone || 'не указан', key: 'phone', editable: true },
                { label: 'Электронная почта:', value: user.email || 'не указан', key: 'email', editable: true },
                { label: 'Группа:', value: user.groupName || 'не указана', key: 'groupName', editable: true },
                { label: 'Фото URL:', value: user.photoUrl || '', key: 'photoUrl', editable: true },
                { label: 'Статус:', value: 'Активный', key: 'status', editable: false }
            ];
            
            const container = document.getElementById('profileDetails');
            container.innerHTML = '';
            
            fields.forEach(field => {
                const row = document.createElement('div');
                row.className = 'detail-row';
                
                const labelSpan = document.createElement('span');
                labelSpan.className = 'detail-label';
                labelSpan.textContent = field.label;
                
                if (editMode && field.editable) {
                    const input = document.createElement('input');
                    input.type = 'text';
                    input.className = 'edit-input';
                    input.value = field.value;
                    input.id = `edit_${field.key}`;
                    row.appendChild(labelSpan);
                    row.appendChild(input);
                } else {
                    const valueSpan = document.createElement('span');
                    valueSpan.className = 'detail-value';
                    if (field.label.includes('Статус')) {
                        valueSpan.classList.add('status-active');
                    }
                    if (field.key === 'photoUrl') {
                        valueSpan.textContent = (field.value && field.value !== '') ? 'Есть' : 'Нет изображения';
                    } else {
                        valueSpan.textContent = field.value;
                    }
                    row.appendChild(labelSpan);
                    row.appendChild(valueSpan);
                }
                container.appendChild(row);
            });
            
            const editActions = document.getElementById('editActions');
            editActions.style.display = editMode ? 'flex' : 'none';
            
            const editBtn = document.getElementById('editProfileBtn');
            if (editMode) {
                editBtn.classList.add('editing');
            } else {
                editBtn.classList.remove('editing');
            }
        }

        async function saveProfile() {
            const user = loadUserData();
            if (!user) return;
            
            const updatedData = {
                userId: user.userId,
                phone: document.getElementById('edit_phone')?.value || '',
                email: document.getElementById('edit_email')?.value || '',
                groupName: document.getElementById('edit_groupName')?.value || '',
                photoUrl: document.getElementById('edit_photoUrl')?.value || ''
            };
            
            try {
                const response = await fetch('/api/profile/update', {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(updatedData)
                });
                
                const result = await response.json();
                
                if (response.ok) {
                    user.phone = updatedData.phone;
                    user.email = updatedData.email;
                    user.groupName = updatedData.groupName;
                    user.photoUrl = updatedData.photoUrl;
                    localStorage.setItem('user', JSON.stringify(user));
                    
                    const avatarImg = document.getElementById('avatarImg');
                    if (avatarImg) {
                        avatarImg.src = updatedData.photoUrl || '/img/no_photo_profile.png';
                    }
                    
                    showModal('Профиль успешно обновлён!');
                    isEditing = false;
                    displayProfile(user, false);
                } else {
                    showModal(result.message || 'Ошибка при обновлении');
                }
            } catch (error) {
                console.error('Ошибка:', error);
                showModal('Произошла ошибка при подключении к серверу');
            }
        }

        async function loadUserStats() {
            const user = loadUserData();
            if (!user) return;
            
            try {
                const response = await fetch(`/api/profile/stats/${user.userId}`);
                if (!response.ok) throw new Error('Ошибка загрузки статистики');
                
                const stats = await response.json();
                
                const expPercent = Math.min((stats.experience / stats.nextLevelExp) * 100, 100);
                document.getElementById('expProgressFill').style.width = `${expPercent}%`;
                document.getElementById('expCurrent').textContent = stats.experience;
                document.getElementById('expMax').textContent = `${stats.nextLevelExp} XP`;
                document.getElementById('courseProgressFill').style.width = `${stats.courseProgress}%`;
                document.getElementById('courseCurrent').innerHTML = `${stats.courseProgress}<span class="small-unit">%</span>`;
                document.getElementById('avgScoreFill').style.width = `${stats.averageScore}%`;
                document.getElementById('avgScoreCurrent').innerHTML = `${stats.averageScore}<span class="small-unit">/100</span>`;
                document.getElementById('headerLevel').textContent = stats.level;
                
                const updatedUser = JSON.parse(localStorage.getItem('user'));
                if (updatedUser) {
                    updatedUser.experience = stats.experience;
                    updatedUser.level = stats.level;
                    localStorage.setItem('user', JSON.stringify(updatedUser));
                }
                
            } catch (error) {
                console.error('Ошибка загрузки статистики:', error);
            }
        }

        async function loadRecentAchievements() {
            const user = loadUserData();
            if (!user) return;
            
            const container = document.getElementById('recentAchievementsTable');
            if (!container) return;
            
            try {
                const response = await fetch(`/api/AchievementsApi/user/${user.userId}`);
                if (!response.ok) throw new Error('Ошибка загрузки достижений');
                
                const data = await response.json();
                
                // Обновляем статистику достижений
                const unlocked = data.totalUnlocked;
                const total = data.totalAchievements;
                const percent = data.unlockedPercent || 0;
                
                document.getElementById('unlockedAchievements').textContent = unlocked;
                document.getElementById('totalAchievements').textContent = total;
                document.getElementById('achievementsProgress').textContent = percent;
                document.getElementById('achievementsProgressFill').style.width = `${percent}%`;
                document.getElementById('collectionProgressFill').style.width = `${percent}%`;
                
                const totalXp = data.achievements
                    .filter(a => a.isUnlocked)
                    .reduce((sum, a) => sum + a.pointsReward, 0);
                document.getElementById('totalXp').textContent = totalXp;
                
                const unlockedAchievements = data.achievements.filter(a => a.isUnlocked);
                const recentAchievements = unlockedAchievements.slice(-5).reverse();
                
                if (recentAchievements.length === 0) {
                    container.innerHTML = '<div class="empty-achievements">✨ Нет полученных достижений<br>Пройдите уроки, чтобы открыть их!</div>';
                    return;
                }
                
                function getAchievementIcon(title) {
                    const iconMap = {
                        'Первый слой': '🎯',
                        'Знаток FDM': '🏆',
                        'Мастер настройки': '⚙️',
                        'Мастер 3D-печати': '🖨️',
                        'Сравнительный аналитик': '📊',
                        'Активный ученик': '📚',
                        'Эксперт FDM': '⭐',
                        'Путешественник': '🗺️',
                        'Быстрый старт': '🚀',
                        'Любознательный': '🔍',
                        'Лидер рейтинга': '👑'
                    };
                    return iconMap[title] || '🏅';
                }
                
                function escapeHtml(str) {
                    if (!str) return '';
                    return str
                        .replace(/&/g, '&amp;')
                        .replace(/</g, '&lt;')
                        .replace(/>/g, '&gt;')
                        .replace(/"/g, '&quot;')
                        .replace(/'/g, '&#39;');
                }
                
                container.innerHTML = `
                    <table class="achievements-table">
                        <thead>
                            <tr>
                                <th>Достижение</th>
                                <th>Описание</th>
                                <th>XP</th>
                                <th>Дата</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${recentAchievements.map(achievement => `
                                <tr onclick="window.location.href='/Home/Achievements'" style="cursor: pointer;">
                                    <td class="achievement-cell">
                                        <div class="achievement-icon-table">
                                            ${getAchievementIcon(achievement.title)}
                                        </div>
                                        <span class="achievement-name-table">${escapeHtml(achievement.title)}</span>
                                    </td>
                                    <td class="desc-cell">${escapeHtml(achievement.description)}</td>
                                    <td class="xp-cell">⭐ ${achievement.pointsReward}</td>
                                    <td class="date-cell">📅 ${achievement.unlockedAt || 'Недавно'}</td>
                                　　
                            `).join('')}
                        </tbody>
                    </table>
                `;
                
            } catch (error) {
                console.error('Ошибка загрузки достижений:', error);
                container.innerHTML = '<div class="loading-small">Не удалось загрузить достижения</div>';
            }
        }

        const user = loadUserData();
        if (user) {
            currentUser = user;
            displayProfile(user, false);
            loadUserStats();
            loadRecentAchievements();
        }
        
        document.getElementById('editProfileBtn')?.addEventListener('click', () => {
            if (!isEditing) {
                const freshUser = JSON.parse(localStorage.getItem('user'));
                if (freshUser) {
                    currentUser = freshUser;
                    isEditing = true;
                    displayProfile(currentUser, true, false);
                }
            }
        });
        
        document.getElementById('cancelEditBtn')?.addEventListener('click', () => {
            if (originalUserData) {
                isEditing = false;
                displayProfile(originalUserData, false);
                currentUser = JSON.parse(JSON.stringify(originalUserData));
                localStorage.setItem('user', JSON.stringify(currentUser));
            }
        });
        
        document.getElementById('saveProfileBtn')?.addEventListener('click', saveProfile);
        
        document.getElementById('logoutBtn')?.addEventListener('click', () => {
            localStorage.removeItem('user');
            window.location.href = '/Home/Index';
        });
        
        document.getElementById('notificationBtn')?.addEventListener('click', () => {
            localStorage.removeItem('user');
            window.location.href = '/Home/Index';
        });

        document.querySelector('.nav-item:nth-child(3)')?.addEventListener('click', function() {
            window.location.href = '/Home/Achievements';
        });

        document.querySelector('.nav-item:nth-child(4)')?.addEventListener('click', function() {
            window.location.href = '/Home/Rating';
        });
    </script>
</body>
</html>