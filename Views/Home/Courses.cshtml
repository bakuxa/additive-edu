@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Мои курсы | Аддитивные технологии</title>
    <link rel="stylesheet" href="/css/courses.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
    <div class="page-container">
        <div class="vector-bg vector-1">
            <img src="/img/vector-bg-1.png" alt="фон">
        </div>
        <div class="vector-bg vector-2">
            <img src="/img/vector-bg-2.png" alt="фон">
        </div>

        <aside class="sidebar">
            <div class="sidebar-active"></div>
            <div class="sidebar-header">
                <button class="sidebar-close" id="sidebarCloseBtn">
                    <span></span>
                    <span></span>
                </button>
                <h2 class="menu-title">Меню</h2>
            </div>
            <nav class="sidebar-nav">
                <div class="nav-item" id="profileNav">
                    <img src="/img/icon/profile-icon.png" alt="Профиль" class="nav-icon">
                    <span>Профиль</span>
                </div>
                <div class="nav-item active" id="coursesNav">
                    <img src="/img/icon/courses-icon.png" alt="Мои курсы" class="nav-icon">
                    <span>Обучение</span>
                </div>
                <div class="nav-item" id="achievementsNav">
                    <img src="/img/icon/achievements-icon.png" alt="Достижения" class="nav-icon">
                    <span>Достижения</span>
                </div>
                <div class="nav-item" id="ratingNav">
                    <img src="/img/icon/rating-icon.png" alt="Рейтинг" class="nav-icon">
                    <span>Рейтинг</span>
                </div>
                <div class="nav-item" id="logoutBtn">
                    <img src="/img/icon/logout-icon.png" alt="Выйти" class="nav-icon">
                    <span>Выйти</span>
                </div>
            </nav>
            <div class="sidebar-footer">
                <img src="/img/logo.png" alt="Логотип" class="footer-logo">
            </div>
        </aside>

        <main class="main-content">
            <div class="top-bar">
                <div class="menu-toggle" id="menuToggle">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
                <h1 class="page-title">Мои курсы</h1>
                <div class="logout-btn-top" id="logoutBtnTop">
                    <img src="/img/icon/logout-icon.png" alt="Выйти">
                </div>
            </div>

            <!-- Глобальный прогресс -->
            <div class="global-progress" id="globalProgress" style="display: none;">
                <div class="global-progress-header">
                    <span class="global-progress-title">Общий прогресс обучения</span>
                    <span class="global-progress-stats" id="globalProgressStats">0%</span>
                </div>
                <div class="global-progress-bar">
                    <div class="global-progress-fill" id="globalProgressFill"></div>
                </div>
            </div>

            <!-- Таймлайн курсов -->
            <div class="courses-timeline" id="coursesTimeline">
                <div class="loading-spinner">
                    <div class="spinner"></div>
                    <p>Загрузка курсов...</p>
                </div>
            </div>
        </main>
    </div>
<script>
    let modulesData = [];
    let completedLessonsIds = new Set();
    
    const ACTIVE_MODULE_KEY = 'lastActiveModule';

    function loadUserData() {
        const user = JSON.parse(localStorage.getItem('user'));
        if (!user) {
            window.location.href = '/Home/Login';
            return null;
        }
        return user;
    }

    function saveActiveModule(moduleId) {
        localStorage.setItem(ACTIVE_MODULE_KEY, moduleId);
    }

    function getActiveModule() {
        const saved = localStorage.getItem(ACTIVE_MODULE_KEY);
        if (saved && !isNaN(parseInt(saved))) {
            return parseInt(saved);
        }
        return 1;
    }

    function getDifficultyClass(level) {
        if (level === 1) return 'easy';
        if (level === 2) return 'medium';
        return 'hard';
    }

    function getDifficultyText(level) {
        if (level === 1) return 'Начинающий';
        if (level === 2) return 'Средний';
        return 'Продвинутый';
    }

    function toggleModule(moduleId) {
        const module = document.getElementById(`timeline-module-${moduleId}`);
        module.classList.toggle('expanded');
        if (module.classList.contains('expanded')) {
            saveActiveModule(moduleId);
        }
    }

    async function loadUserProgress(userId) {
    try {
        // Получаем прогресс по урокам
        const lessonsRes = await fetch(`/api/courses/user-lessons-progress/${userId}`);
        if (lessonsRes.ok) {
            const lessonsData = await lessonsRes.json();
            lessonsData.forEach(item => {
                if (item.isCompleted) {
                    completedLessonsIds.add(item.lessonID);
                }
            });
        }
        
        // Дополнительно: проверяем каждый урок, все ли задания выполнены
        // Получаем все модули
        const modulesRes = await fetch('/api/courses/modules');
        if (modulesRes.ok) {
            const modules = await modulesRes.json();
            for (const module of modules) {
                for (const lesson of module.lessons) {
                    // Получаем задания урока
                    const tasksRes = await fetch(`/api/courses/lesson-tasks/${lesson.lessonID}`);
                    if (tasksRes.ok) {
                        const tasks = await tasksRes.json();
                        if (tasks.length > 0) {
                            // Проверяем, все ли задания выполнены
                            let allTasksCompleted = true;
                            for (const task of tasks) {
                                const taskCompletedRes = await fetch(`/api/lesson/task/${task.taskID}/is-completed/${userId}`);
                                if (taskCompletedRes.ok) {
                                    const taskData = await taskCompletedRes.json();
                                    if (!taskData.isCompleted) {
                                        allTasksCompleted = false;
                                        break;
                                    }
                                }
                            }
                            if (allTasksCompleted && !completedLessonsIds.has(lesson.lessonID)) {
                                // Если все задания выполнены, но урок не отмечен - обновляем
                                completedLessonsIds.add(lesson.lessonID);
                                await fetch(`/api/courses/update-lesson-progress/${lesson.lessonID}/${userId}`, {
                                    method: 'POST'
                                });
                            }
                        }
                    }
                }
            }
        }
        
        console.log('Пройденные уроки:', [...completedLessonsIds]);
    } catch (error) {
        console.error('Ошибка загрузки прогресса:', error);
    }
}

    function isModuleFullyCompleted(module) {
        if (!module.lessons || module.lessons.length === 0) return false;
        return module.lessons.every(lesson => completedLessonsIds.has(lesson.lessonID));
    }

    function isLessonAvailable(module, lessonIndex, moduleIndex) {
        const lessons = module.lessons;
        
        if (completedLessonsIds.has(lessons[lessonIndex].lessonID)) {
            return true;
        }
        
        if (moduleIndex === 0 && lessonIndex === 0) {
            return true;
        }
        
        if (lessonIndex === 0 && moduleIndex > 0) {
            const prevModule = modulesData[moduleIndex - 1];
            if (!prevModule) return false;
            return isModuleFullyCompleted(prevModule);
        }
        
        const prevLessonId = lessons[lessonIndex - 1]?.lessonID;
        return prevLessonId && completedLessonsIds.has(prevLessonId);
    }

    function getLessonStatus(lesson, lessonIndex, module, moduleIndex) {
        const isCompleted = completedLessonsIds.has(lesson.lessonID);
        if (isCompleted) return 'completed';
        
        const isAvailable = isLessonAvailable(module, lessonIndex, moduleIndex);
        if (isAvailable) return 'pending';
        
        return 'locked';
    }

    function getStatusIcon(status) {
        const icons = {
            'completed': '✅',
            'pending': '📖',
            'locked': '🔒'
        };
        return icons[status];
    }

    function getModuleProgress(module) {
        if (!module.lessons.length) return 0;
        let completedCount = module.lessons.filter(lesson => 
            completedLessonsIds.has(lesson.lessonID)
        ).length;
        return Math.round((completedCount / module.lessons.length) * 100);
    }

    async function loadCourses() {
        const user = loadUserData();
        if (!user) return;

        const timeline = document.getElementById('coursesTimeline');
        
        await loadUserProgress(user.userId);

        try {
            const response = await fetch('/api/courses/modules');
            if (!response.ok) throw new Error('Ошибка загрузки');
            const modules = await response.json();
            modulesData = modules;

            if (!modules || modules.length === 0) {
                timeline.innerHTML = '<div class="error-message">📚 Курсы пока не добавлены</div>';
                return;
            }

            const tasksMap = {};
            for (const module of modules) {
                for (const lesson of module.lessons) {
                    try {
                        const tasksRes = await fetch(`/api/courses/lesson-tasks/${lesson.lessonID}`);
                        if (tasksRes.ok) {
                            const tasks = await tasksRes.json();
                            tasksMap[lesson.lessonID] = tasks;
                        } else {
                            tasksMap[lesson.lessonID] = [];
                        }
                    } catch (e) {
                        console.error('Ошибка загрузки заданий:', e);
                        tasksMap[lesson.lessonID] = [];
                    }
                }
            }

            let totalLessons = 0;
            let totalCompletedLessons = completedLessonsIds.size;
            modules.forEach(module => {
                totalLessons += module.lessons.length;
            });
            
            const globalProgress = totalLessons > 0 ? Math.round((totalCompletedLessons / totalLessons) * 100) : 0;
            
            const globalProgressDiv = document.getElementById('globalProgress');
            if (globalProgress > 0) {
                globalProgressDiv.style.display = 'block';
                document.getElementById('globalProgressStats').textContent = `${globalProgress}%`;
                document.getElementById('globalProgressFill').style.width = `${globalProgress}%`;
            }

            const activeModuleId = getActiveModule();
            const activeModuleExists = modules.some(m => m.moduleID === activeModuleId);
            const expandedModuleId = activeModuleExists ? activeModuleId : modules[0].moduleID;

            timeline.innerHTML = modules.map((module, moduleIndex) => {
                const moduleProgress = getModuleProgress(module);
                const isModuleCompleted = isModuleFullyCompleted(module);
                
                let moduleStatus = 'locked';
                if (isModuleCompleted) moduleStatus = 'completed';
                else if (moduleProgress > 0) moduleStatus = 'current';
                else if (moduleIndex === 0) moduleStatus = 'current';
                
                const isExpanded = (module.moduleID === expandedModuleId);
                
                return `
                    <div class="timeline-module ${moduleStatus} ${isExpanded ? 'expanded' : ''}" id="timeline-module-${module.moduleID}">
                        <div class="timeline-dot"></div>
                        <div class="timeline-card" onclick="toggleModule(${module.moduleID})">
                            <div class="timeline-card-header">
                                <div class="module-info">
                                    <div class="module-number-panel">Модуль ${module.moduleNumber}</div>
                                    <div class="module-title-section">
                                        <div class="module-name">${escapeHtml(module.moduleTitle)}</div>
                                        <div class="module-meta">
                                            <span class="difficulty-tag ${getDifficultyClass(module.difficultyLevel)}">${getDifficultyText(module.difficultyLevel)}</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="module-progress">
                                    <span class="progress-percent">${moduleProgress}%</span>
                                    <div class="progress-bar-small">
                                        <div class="progress-fill-small" style="width: ${moduleProgress}%"></div>
                                    </div>
                                </div>
                                <div class="expand-arrow">▼</div>
                            </div>
                            <div class="timeline-lessons" onclick="event.stopPropagation()">
                                ${module.lessons.map((lesson, lessonIndex) => {
                                    const status = getLessonStatus(lesson, lessonIndex, module, moduleIndex);
                                    const isAvailable = (status !== 'locked');
                                    const icon = getStatusIcon(status);
                                    const tasks = tasksMap[lesson.lessonID] || [];
                                    
                                    return `
                                        <div class="lesson-row" onclick="${isAvailable ? `window.location.href='/Home/Lesson/${lesson.lessonID}'` : ''}" style="${!isAvailable ? 'opacity: 0.6; cursor: not-allowed;' : 'cursor: pointer;'}">
                                            <div class="lesson-status-icon ${status}">${icon}</div>
                                            <div class="lesson-content">
                                                <div class="lesson-title-row">
                                                    <span class="lesson-name">${escapeHtml(lesson.lessonTitle)}</span>
                                                    <span class="lesson-order-badge">Урок ${lesson.lessonOrder}</span>
                                                </div>
                                                <div class="lesson-desc">${escapeHtml(lesson.lessonDescription || 'Нет описания')}</div>
                                                <div class="tasks-list">
                                                    ${tasks.map(task => {
                                                        let taskIcon = '📝';
                                                        let taskTypeClass = '';
                                                        
                                                        if (task.typeName === 'Тест') {
                                                            taskIcon = '📝';
                                                            taskTypeClass = 'test';
                                                        } else if (task.typeName === 'Симулятор') {
                                                            taskIcon = '🎮';
                                                            taskTypeClass = 'simulator';
                                                        } else if (task.typeName === 'Квест') {
                                                            taskIcon = '🗺️';
                                                            taskTypeClass = 'quest';
                                                        }
                                                        
                                                        return `
                                                            <div class="task-pill ${taskTypeClass}" onclick="event.stopPropagation(); ${isAvailable ? `window.location.href='/Home/Lesson/${lesson.lessonID}'` : ''}" style="${!isAvailable ? 'opacity: 0.5; cursor: not-allowed;' : 'cursor: pointer;'}">
                                                                <span class="task-pill-icon">${taskIcon}</span>
                                                                <span class="task-pill-title">${escapeHtml(task.taskTitle)}</span>
                                                                <span class="task-pill-score">${task.maxScore} XP</span>
                                                            </div>
                                                        `;
                                                    }).join('')}
                                                    ${tasks.length === 0 ? '<span class="no-tasks">Нет заданий</span>' : ''}
                                                </div>
                                            </div>
                                            ${status === 'completed' ? '<div class="lesson-completed-badge">✅ Пройден</div>' : ''}
                                        </div>
                                    `;
                                }).join('')}
                                ${module.lessons.length === 0 ? '<div style="padding: 20px; text-align: center; color: #8A9AA5;">Уроки пока не добавлены</div>' : ''}
                            </div>
                        </div>
                    </div>
                `;
            }).join('');

        } catch (error) {
            console.error('Ошибка:', error);
            timeline.innerHTML = `<div class="error-message">⚠️ Ошибка загрузки курсов: ${error.message}</div>`;
        }
    }

    function escapeHtml(str) {
        if (!str) return '';
        return str
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    function logout() {
        localStorage.removeItem('user');
        window.location.href = '/Home/Index';
    }
    // Мобильное меню
    const menuToggle = document.getElementById('menuToggle');
    const sidebarCloseBtn = document.getElementById('sidebarCloseBtn');
    const sidebar = document.querySelector('.sidebar');

    if (menuToggle) {
        menuToggle.addEventListener('click', (e) => {
            e.stopPropagation();
            menuToggle.classList.toggle('open');
            sidebar.classList.toggle('open');
        });
    }

    if (sidebarCloseBtn) {
        sidebarCloseBtn.addEventListener('click', () => {
            sidebar.classList.remove('open');
            if (menuToggle) menuToggle.classList.remove('open');
        });
    }

    // Закрывать меню при клике вне его
    document.addEventListener('click', (e) => {
        if (window.innerWidth <= 480) {
            if (sidebar && menuToggle) {
                if (!sidebar.contains(e.target) && !menuToggle.contains(e.target)) {
                    sidebar.classList.remove('open');
                    menuToggle.classList.remove('open');
                }
            }
        }
    });

    document.getElementById('profileNav')?.addEventListener('click', () => {
        window.location.href = '/Home/Profile';
    });

    document.getElementById('coursesNav')?.addEventListener('click', () => {
        window.location.href = '/Home/Courses';
    });

    document.getElementById('achievementsNav')?.addEventListener('click', () => {
        window.location.href = '/Home/Achievements';
    });

    document.getElementById('ratingNav')?.addEventListener('click', () => {
        window.location.href = '/Home/Rating';
    });

    document.getElementById('logoutBtn')?.addEventListener('click', logout);
    document.getElementById('logoutBtnTop')?.addEventListener('click', logout);

    loadCourses();

    // Функция выхода
        function logout() {
            localStorage.removeItem('user');
            window.location.href = '/Home/Index';
        }

        // Кнопка выхода в меню (sidebar)
        document.getElementById('logoutBtn')?.addEventListener('click', logout);

        // Кнопка выхода в верхней панели (top-bar)
        document.getElementById('logoutBtnTop')?.addEventListener('click', logout);

</script>
</body>
</html>