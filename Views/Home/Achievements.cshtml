@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Достижения | Аддитивные технологии</title>
        <link rel="stylesheet" href="/css/achievements.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
    <div class="page-container">
        <div class="vector-bg vector-1">
            <img src="/img/vector-bg-1.png" alt="фон" onerror="this.style.display='none'">
        </div>
        <div class="vector-bg vector-2">
            <img src="/img/vector-bg-2.png" alt="фон" onerror="this.style.display='none'">
        </div>

        <aside class="sidebar">
            <div class="sidebar-active"></div>
            <div class="sidebar-header">
                <h2 class="menu-title">Меню</h2>
            </div>
            <nav class="sidebar-nav">
                <div class="nav-item" id="profileNav">
                    <img src="/img/icon/profile-icon.png" alt="Профиль" class="nav-icon" onerror="this.style.display='none'">
                    <span>Профиль</span>
                </div>
                <div class="nav-item" id="coursesNav">
                    <img src="/img/icon/courses-icon.png" alt="Мои курсы" class="nav-icon" onerror="this.style.display='none'">
                    <span>Мои курсы</span>
                </div>
                <div class="nav-item active" id="achievementsNav">
                    <img src="/img/icon/achievements-icon.png" alt="Достижения" class="nav-icon" onerror="this.style.display='none'">
                    <span>Достижения</span>
                </div>
                <div class="nav-item" id="ratingNav">
                    <img src="/img/icon/rating-icon.png" alt="Рейтинг" class="nav-icon" onerror="this.style.display='none'">
                    <span>Рейтинг</span>
                </div>
                <div class="nav-item" id="logoutBtn">
                    <img src="/img/icon/logout-icon.png" alt="Выйти" class="nav-icon" onerror="this.style.display='none'">
                    <span>Выйти</span>
                </div>
            </nav>
            <div class="sidebar-footer" style="position: absolute; top: 620px; left: 0; right: 0; margin-top: 0;">
                <img src="/img/logo.png" alt="Логотип" class="footer-logo">
            </div>
        </aside>

        <main class="main-content">
            <div class="top-bar">
                <h1 class="page-title">Мои достижения</h1>
                <div class="logout-btn-top" id="logoutBtnTop">
                    <img src="/img/icon/logout-icon.png" alt="Выйти" onerror="this.style.display='none'">
                </div>
            </div>

            <!-- Статистика достижений -->
            <div class="stats-card">
                <div class="stats-header">
                    <span class="stats-title">Прогресс коллекционирования</span>
                    <span class="stats-percent" id="statsPercent">0%</span>
                </div>
                <div class="stats-progress">
                    <div class="stats-progress-fill" id="statsProgressFill" style="width: 0%;"></div>
                </div>
                <div class="stats-info">
                    <span id="unlockedCount">0</span> из <span id="totalCount">0</span> достижений получено
                </div>
            </div>

            <!-- Сетка достижений -->
            <div class="achievements-grid" id="achievementsGrid">
                <div class="loading-spinner">
                    <div class="spinner"></div>
                    <p>Загрузка достижений...</p>
                </div>
            </div>
        </main>
    </div>

    <!-- Модальное окно -->
    <div class="modal-overlay" id="achievementModal">
        <div class="modal-container">
            <div class="modal-close" id="modalCloseBtn">×</div>
            <div class="modal-congrats" id="modalCongrats">
                <h2>Поздравляем!</h2>
                <p>Вы открыли новое достижение</p>
            </div>
            <div class="modal-achievement" id="modalAchievementContent">
                <!-- Динамическое содержимое -->
            </div>
            <button class="modal-button" id="modalClaimBtn">Забрать XP</button>
        </div>
    </div>

    <script>
        let currentUser = null;
        let currentAchievement = null;
        
        // Ключ для хранения в localStorage полученных наград
        const CLAIMED_REWARDS_KEY = 'claimedAchievements';

        // Получить список уже полученных наград
        function getClaimedRewards() {
            const claimed = localStorage.getItem(CLAIMED_REWARDS_KEY);
            if (!claimed) return {};
            return JSON.parse(claimed);
        }

        // Сохранить, что награда за достижение получена
        function saveClaimedReward(userId, achievementId) {
            const claimed = getClaimedRewards();
            const key = `${userId}_${achievementId}`;
            claimed[key] = new Date().toISOString();
            localStorage.setItem(CLAIMED_REWARDS_KEY, JSON.stringify(claimed));
        }

        // Проверить, получал ли пользователь награду за это достижение
        function isRewardClaimed(userId, achievementId) {
            const claimed = getClaimedRewards();
            const key = `${userId}_${achievementId}`;
            return !!claimed[key];
        }

        function loadUserData() {
            const user = JSON.parse(localStorage.getItem('user'));
            if (!user) {
                window.location.href = '/Home/Login';
                return null;
            }
            return user;
        }

        function getEmojiForTitle(title) {
            const emojiMap = {
                'Первый слой': '🎯',
                'Знаток FDM': '🏆',
                'Мастер настройки': '⚙️',
                'Мастер 3D-печати': '🖨️',
                'Сравнительный аналитик': '📊',
                'Активный ученик': '📚',
                'Эксперт FDM': '⭐',
                'Путешественник': '🗺️',
                'Быстрый старт': '🚀',
                'Любознательный': '🔍',
                'Лидер рейтинга': '👑'
            };
            return emojiMap[title] || '🏅';
        }

        function showModal(achievement) {
            currentAchievement = achievement;
            const user = loadUserData();
            
            const modalContent = document.getElementById('modalAchievementContent');
            const modalCongrats = document.getElementById('modalCongrats');
            
            // Меняем содержимое модального окна в зависимости от статуса достижения
            const isUnlocked = achievement.isUnlocked;
            const alreadyClaimed = user ? isRewardClaimed(user.userId, achievement.achievementId) : false;
            
            if (isUnlocked) {
                // Если достижение получено
                modalCongrats.innerHTML = `
                    <h2>Поздравляем! 🎉</h2>
                    <p>Вы открыли новое достижение</p>
                `;
            } else {
                // Если достижение ещё не получено
                modalCongrats.innerHTML = `
                    <h2>🔒 Достижение не открыто</h2>
                    <p>Постарайся лучше, чтобы получить это достижение!</p>
                `;
            }
            
            modalContent.innerHTML = `
                <div class="modal-achievement-icon">
                    ${getEmojiForTitle(achievement.title)}
                </div>
                <div class="modal-achievement-info">
                    <h3 class="modal-achievement-title">${escapeHtml(achievement.title)}</h3>
                    <p class="modal-achievement-desc">${escapeHtml(achievement.description)}</p>
                    <div class="modal-points">
                        <span>⭐</span>
                        <span>${achievement.pointsReward} XP</span>
                    </div>
                    ${!isUnlocked ? `
                        <div class="modal-condition" style="margin-top: 10px; padding: 8px 12px; background: #F0F0F0; border-radius: 12px;">
                            <span style="font-size: 12px; color: #666;">Условие получения:</span>
                            <p style="font-size: 12px; color: #029FA4; margin-top: 4px;">${escapeHtml(achievement.conditionDescription || 'Выполните задание для открытия достижения')}</p>
                        </div>
                    ` : ''}
                </div>
            `;
            
            const modalBtn = document.getElementById('modalClaimBtn');
            
            // Проверяем, можно ли получить награду
            const canClaim = isUnlocked && !alreadyClaimed;
            
            if (canClaim) {
                modalBtn.textContent = 'Забрать XP';
                modalBtn.classList.remove('locked-btn');
                modalBtn.disabled = false;
            } else if (alreadyClaimed) {
                modalBtn.textContent = '✅ XP уже получены';
                modalBtn.classList.add('locked-btn');
                modalBtn.disabled = true;
            } else {
                modalBtn.textContent = '🔒 Достижение ещё не получено';
                modalBtn.classList.add('locked-btn');
                modalBtn.disabled = true;
            }
            
            document.getElementById('achievementModal').classList.add('active');
        }

        function closeModal() {
            document.getElementById('achievementModal').classList.remove('active');
            currentAchievement = null;
        }

        async function claimXP() {
            if (!currentAchievement || !currentAchievement.isUnlocked) return;
            
            const user = loadUserData();
            if (!user) return;
            
            // Проверяем, не получал ли уже награду
            if (isRewardClaimed(user.userId, currentAchievement.achievementId)) {
                showToast('Вы уже получили XP за это достижение!');
                closeModal();
                return;
            }
            
            const modalBtn = document.getElementById('modalClaimBtn');
            modalBtn.textContent = '⏳ Обработка...';
            modalBtn.disabled = true;
            
            try {
                const response = await fetch('/api/AchievementsApi/claim-xp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        userId: user.userId,
                        achievementId: currentAchievement.achievementId
                    })
                });
                
                const result = await response.json();
                
                if (response.ok && result.success) {
                    // Сохраняем в localStorage, что награда получена
                    saveClaimedReward(user.userId, currentAchievement.achievementId);
                    
                    modalBtn.textContent = `✅ +${result.xpEarned} XP получено!`;
                    
                    // Обновляем данные пользователя в localStorage
                    const updatedUser = JSON.parse(localStorage.getItem('user'));
                    if (updatedUser) {
                        updatedUser.experience = result.newExperience;
                        updatedUser.level = result.newLevel;
                        localStorage.setItem('user', JSON.stringify(updatedUser));
                    }
                    
                    setTimeout(() => {
                        closeModal();
                        loadAchievements(); // Обновляем список
                    }, 1500);
                } else {
                    modalBtn.textContent = result.message || '❌ Ошибка';
                    setTimeout(() => {
                        if (currentAchievement && currentAchievement.isUnlocked && 
                            !isRewardClaimed(user.userId, currentAchievement.achievementId)) {
                            modalBtn.textContent = 'Забрать XP';
                            modalBtn.disabled = false;
                        }
                    }, 2000);
                }
            } catch (error) {
                console.error('Ошибка:', error);
                modalBtn.textContent = '❌ Ошибка сервера';
                setTimeout(() => {
                    if (currentAchievement && currentAchievement.isUnlocked && 
                        !isRewardClaimed(user.userId, currentAchievement.achievementId)) {
                        modalBtn.textContent = 'Забрать XP';
                        modalBtn.disabled = false;
                    }
                }, 2000);
            }
        }

        function showToast(message) {
            // Создаем всплывающее уведомление
            const toast = document.createElement('div');
            toast.className = 'custom-toast';
            toast.textContent = message;
            toast.style.cssText = `
                position: fixed;
                bottom: 20px;
                right: 20px;
                background: linear-gradient(135deg, #029FA4, #8ED1D1);
                color: white;
                padding: 12px 24px;
                border-radius: 12px;
                font-family: 'Poppins', sans-serif;
                font-size: 14px;
                z-index: 1001;
                animation: slideIn 0.3s ease-out;
            `;
            document.body.appendChild(toast);
            setTimeout(() => toast.remove(), 3000);
        }

        async function loadAchievements() {
            const user = loadUserData();
            if (!user) return;
            currentUser = user;

            const grid = document.getElementById('achievementsGrid');
            grid.innerHTML = '<div class="loading-spinner"><div class="spinner"></div><p>Загрузка достижений...</p></div>';

            try {
                const response = await fetch(`/api/AchievementsApi/user/${user.userId}`);
                
                if (!response.ok) {
                    const errorText = await response.text();
                    throw new Error(`Сервер вернул ${response.status}: ${errorText.substring(0, 100)}`);
                }
                
                const data = await response.json();
                
                const percent = data.unlockedPercent || 0;
                document.getElementById('statsPercent').textContent = `${percent}%`;
                document.getElementById('statsProgressFill').style.width = `${percent}%`;
                document.getElementById('unlockedCount').textContent = data.totalUnlocked;
                document.getElementById('totalCount').textContent = data.totalAchievements;

                renderAchievements(data.achievements);

            } catch (error) {
                console.error('Ошибка:', error);
                grid.innerHTML = `<div class="error-message">
                    ⚠️ Ошибка загрузки достижений: ${error.message}<br><br>
                    <button onclick="location.reload()" style="padding: 8px 20px; background: #029FA4; color: white; border: none; border-radius: 8px; cursor: pointer;">Повторить</button>
                </div>`;
            }
        }

        function renderAchievements(achievements) {
            const grid = document.getElementById('achievementsGrid');
            const user = loadUserData();
            
            if (!achievements || achievements.length === 0) {
                grid.innerHTML = '<div class="empty-message">Достижения пока не добавлены</div>';
                return;
            }

            grid.innerHTML = achievements.map(achievement => `
                <div class="achievement-card ${achievement.isUnlocked ? 'unlocked' : 'locked'}" 
                    onclick='showModal(${JSON.stringify(achievement).replace(/'/g, "&#39;")})'>
                    <div class="achievement-check">
                        ${achievement.isUnlocked 
                            ? '<div class="check-icon">✓</div>' 
                            : '<div class="lock-icon">🔒</div>'}
                    </div>
                    <div class="achievement-icon">
                        ${getEmojiForTitle(achievement.title)}
                    </div>
                    <div class="achievement-content">
                        <h3 class="achievement-title">${escapeHtml(achievement.title)}</h3>
                        <p class="achievement-description">${escapeHtml(achievement.description)}</p>
                        ${achievement.isUnlocked && achievement.unlockedAt ? 
                            `<div class="achievement-date">📅 Получено: ${achievement.unlockedAt}</div>` : 
                            `<div class="achievement-date" style="color: #8E9CA8;">🔒 ${escapeHtml(achievement.conditionDescription || 'Выполните условие для получения')}</div>`
                        }
                        <div class="achievement-points">
                            <span>⭐</span>
                            <span class="points-value">${achievement.pointsReward} XP</span>
                        </div>
                        ${achievement.isUnlocked && user && isRewardClaimed(user.userId, achievement.achievementId) ? 
                            `<div style="font-size: 10px; color: #029FA4; margin-top: 5px;">✅ Награда получена</div>` : 
                            (achievement.isUnlocked ? `<div style="font-size: 10px; color: #FF9800; margin-top: 5px;">✨ Награда доступна</div>` : '')
                        }
                    </div>
                </div>
            `).join('');
        }

        function escapeHtml(str) {
            if (!str) return '';
            return str
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function logout() {
            localStorage.removeItem('user');
            window.location.href = '/Home/Index';
        }

        // Навигация
        document.getElementById('profileNav')?.addEventListener('click', () => {
            window.location.href = '/Home/Profile';
        });

        document.getElementById('coursesNav')?.addEventListener('click', () => {
            window.location.href = '/Home/Courses';
        });

        document.getElementById('ratingNav')?.addEventListener('click', () => {
            window.location.href = '/Home/Rating';
        });

        document.getElementById('logoutBtn')?.addEventListener('click', logout);
        document.getElementById('logoutBtnTop')?.addEventListener('click', logout);
        
        // Модальное окно
        document.getElementById('modalCloseBtn')?.addEventListener('click', closeModal);
        document.getElementById('modalClaimBtn')?.addEventListener('click', claimXP);
        
        document.getElementById('achievementModal')?.addEventListener('click', (e) => {
            if (e.target === document.getElementById('achievementModal')) {
                closeModal();
            }
        });

        loadAchievements();
    </script>
</body>
</html>