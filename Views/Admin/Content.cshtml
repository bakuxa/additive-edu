        async function saveStageToServer(stage, index, stageId, taskId) {
    const actualTaskId = taskId || editingTaskId;
    
    if (!actualTaskId) {
        console.error('Нет taskId для сохранения этапа');
        return false;
    }
    
    const stageData = {
        taskId: actualTaskId,
        stageTitle: stage.stageTitle,
        stageDescription: stage.stageDescription || '',
        stageOrder: index + 1,
        successCondition: stage.successCondition || ''
    };
    
    console.log('Сохранение этапа для taskId:', actualTaskId, stageData);
    
    try {
        const url = stageId ? `/api/admin/content/quest-stages/${stageId}` : '/api/admin/content/quest-stages';
        const method = stageId ? 'PUT' : 'POST';
        const response = await fetch(url, { 
            method, 
            headers: { 'Content-Type': 'application/json' }, 
            body: JSON.stringify(stageData) 
        });
        
        if (!response.ok) {
            const errorText = await response.text();
            console.error('Ошибка сохранения этапа:', errorText);
            showToast('Ошибка при сохранении этапа');
            return false;
        }
        
        const result = await response.json();
        if (result.questStageId && !stageId) {
            stage.questStageId = result.questStageId;
        }
        return true;
    } catch (error) { 
        console.error('Ошибка:', error);
        showToast('Произошла ошибка при сохранении этапа'); 
        return false;
    }
}

async function saveTask() {
    const data = {
        lessonId: currentLessonId,
        typeName: document.getElementById('taskType').value,
        taskTitle: document.getElementById('taskTitle').value.trim(),
        taskDescription: document.getElementById('taskDescription').value.trim(),
        difficultyLevel: parseInt(document.getElementById('taskDifficulty').value),
        maxScore: parseInt(document.getElementById('taskMaxScore').value),
        isActive: document.getElementById('taskActive').checked
    };
    
    if (!data.taskTitle) { 
        showToast('Введите название задания'); 
        return; 
    }
    
    try {
        const url = editingTaskId ? `/api/admin/content/tasks/${editingTaskId}` : '/api/admin/content/tasks';
        const method = editingTaskId ? 'PUT' : 'POST';
        
        const response = await fetch(url, { 
            method, 
            headers: { 'Content-Type': 'application/json' }, 
            body: JSON.stringify(data) 
        });
        
        if (response.ok) {
            const result = await response.json();
            const currentTaskId = result.taskId || editingTaskId;
            const taskType = data.typeName;
            
            const actionText = editingTaskId ? `изменено задание "${data.taskTitle}" (${taskType})` : `создано задание "${data.taskTitle}" (${taskType})`;
            
            if (taskType === 'Тест') {
                for (let i = 0; i < currentQuestions.length; i++) {
                    const question = currentQuestions[i];
                    if (question.questionText && question.questionText.trim()) {
                        await saveQuestionToServer(question, i, question.questionId, currentTaskId);
                    }
                }
            } 
            else if (taskType === 'Сопоставление') {
                await saveMatchingToServer(currentTaskId);
            }
            else if (taskType === 'Квест') {
                for (let i = 0; i < currentStages.length; i++) {
                    const stage = currentStages[i];
                    if (stage.stageTitle && stage.stageTitle.trim()) {
                        await saveStageToServer(stage, i, stage.questStageId, currentTaskId);
                    }
                }
            }
            
            if (typeof window.addAdminAction === 'function') {
                const icon = taskType === 'Тест' ? '📝' : (taskType === 'Сопоставление' ? '🔄' : '🗺️');
                window.addAdminAction(icon, actionText);
            }
            
            showToast('Задание сохранено');
            document.getElementById('taskModal').style.display = 'none';
            document.body.classList.remove('modal-open');
            loadContent();
        } else {
            const errorText = await response.text();
            console.error('Ошибка сохранения задания:', errorText);
            showToast('Ошибка при сохранении задания');
        }
    } catch (error) { 
        console.error('Ошибка:', error);
        showToast('Произошла ошибка'); 
    }
}
        function initSortable(containerId, onOrderChange) {
            const container = document.getElementById(containerId);
            if (!container) return;
            
            let draggedItem = null;
            
            const items = container.querySelectorAll('.sortable-item');
            
            items.forEach(item => {
                item.setAttribute('draggable', 'true');
                
                item.addEventListener('dragstart', (e) => {
                    draggedItem = item;
                    item.classList.add('dragging');
                    e.dataTransfer.effectAllowed = 'move';
                    e.dataTransfer.setData('text/plain', '');
                });
                
                item.addEventListener('dragend', (e) => {
                    item.classList.remove('dragging');
                    draggedItem = null;
                    if (onOrderChange) onOrderChange();
                });
                
                item.addEventListener('dragover', (e) => {
                    e.preventDefault();
                    e.dataTransfer.dropEffect = 'move';
                });
                
                item.addEventListener('drop', (e) => {
                    e.preventDefault();
                    if (draggedItem && draggedItem !== item) {
                        const rect = item.getBoundingClientRect();
                        const offset = e.clientY - rect.top;
                        if (offset < rect.height / 2) {
                            item.parentNode.insertBefore(draggedItem, item);
                        } else {
                            item.parentNode.insertBefore(draggedItem, item.nextSibling);
                        }
                    }
                });
            });
        }

