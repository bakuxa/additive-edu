        async function loadTaskData(taskId) {
    try {
        // Загружаем вопросы для теста (это также содержит данные сопоставления)
        const questionsRes = await fetch(`/api/admin/content/questions/by-task/${taskId}`);
        if (questionsRes.ok) {
            const allQuestions = await questionsRes.json();
            console.log('Загружено вопросов (сырые):', allQuestions);
            
            // Разделяем: обычные вопросы для теста vs данные сопоставления
            const testQuestions = [];
            let matchingDataFound = null;
            
            for (const q of allQuestions) {
                // Проверяем, является ли вопрос данными для сопоставления
                if (q.questionText && q.questionText.trim().startsWith('{') && 
                    (q.questionText.includes('"leftItems"') || q.questionText.includes('"rightItems"'))) {
                    try {
                        const parsed = JSON.parse(q.questionText);
                        if (parsed.leftItems && parsed.rightItems) {
                            matchingDataFound = parsed;
                            console.log('Найдены данные сопоставления:', matchingDataFound);
                            continue; // Не добавляем в обычные вопросы
                        }
                    } catch(e) {
                        console.error('Ошибка парсинга questionText как matching:', e);
                    }
                }
                testQuestions.push(q);
            }
            
            currentQuestions = testQuestions;
            
            // Если нашли данные сопоставления - загружаем их в currentPairs
            if (matchingDataFound && matchingDataFound.leftItems && matchingDataFound.rightItems) {
                currentPairs = matchingDataFound.leftItems.map((left, idx) => ({
                    leftText: left,
                    rightText: matchingDataFound.rightItems[idx] || ''
                }));
                console.log('Загружено пар сопоставления из questionText:', currentPairs);
            } else {
                // Пробуем загрузить через отдельный API (на всякий случай)
                const matchingRes = await fetch(`/api/admin/content/matching/by-task/${taskId}`);
                if (matchingRes.ok) {
                    const matchingData = await matchingRes.json();
                    if (matchingData.leftItems && matchingData.leftItems.length) {
                        currentPairs = matchingData.leftItems.map((left, idx) => ({
                            leftText: left,
                            rightText: matchingData.rightItems[idx] || ''
                        }));
                    } else {
                        currentPairs = [];
                    }
                } else {
                    currentPairs = [];
                }
            }
        } else {
            currentQuestions = [];
            currentPairs = [];
        }
        
        // Загружаем этапы квеста
        const stagesRes = await fetch(`/api/admin/content/quest-stages/by-task/${taskId}`);
        if (stagesRes.ok) {
            currentStages = await stagesRes.json();
            console.log('Загружено этапов квеста:', currentStages.length);
        } else {
            currentStages = [];
        }
    } catch (error) { 
        console.error('Ошибка загрузки данных задания:', error);
        currentQuestions = [];
        currentPairs = [];
        currentStages = [];
    }
}
