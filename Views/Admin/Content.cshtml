@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Управление контентом | Админ панель</title>
    <link rel="stylesheet" href="/css/admin-content.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="/js/admin-common.js"></script>
</head>
<body>
    <div class="page-container">
        <div class="vector-bg vector-1"><img src="/img/vector-bg-1.png" alt="фон"></div>
        <div class="vector-bg vector-2"><img src="/img/vector-bg-2.png" alt="фон"></div>

        <div class="top-bar">
            <div class="logo"><img src="/img/logo.png" alt="Логотип"></div>
            <h1 class="page-title"><span class="gradient-text">Управление контентом</span></h1>
            <div class="user-profile" id="profileBtn">
                <span class="user-name" id="userName"></span>
                <img src="/img/icon/profile-icon.png" alt="Профиль" class="profile-icon">
            </div>
        </div>

        <div class="profile-dropdown" id="profileDropdown">
            <div class="dropdown-item" id="profileSettingsBtn"><img src="/img/icon/profile-icon.png" alt="Профиль" class="dropdown-icon"><span>Мой профиль</span></div>
            <div class="dropdown-divider"></div>
            <div class="dropdown-item" id="dashboardBtn"><img src="/img/icon/dashboard-icon.png" alt="Панель управления" class="dropdown-icon"><span>Панель управления</span></div>
            <div class="dropdown-divider"></div>
            <div class="dropdown-item" id="logoutBtn"><img src="/img/icon/logout-icon.png" alt="Выйти" class="dropdown-icon"><span>Выйти</span></div>
        </div>

        <main class="main-content">
            <button class="back-to-dashboard-btn" id="backToDashboardBtn">
                    ← Вернуться
            </button>
            <div class="stats-grid">
                <div class="stat-card"><div class="stat-icon">📚</div><div class="stat-info"><div class="stat-value" id="modulesCount">0</div><div class="stat-label">Всего модулей</div></div></div>
                <div class="stat-card"><div class="stat-icon">📖</div><div class="stat-info"><div class="stat-value" id="lessonsCount">0</div><div class="stat-label">Всего уроков</div></div></div>
                <div class="stat-card"><div class="stat-icon">📝</div><div class="stat-info"><div class="stat-value" id="tasksCount">0</div><div class="stat-label">Всего заданий</div></div></div>
                <div class="stat-card"><div class="stat-icon">✅</div><div class="stat-info"><div class="stat-value" id="activeTasksCount">0</div><div class="stat-label">Активных заданий</div></div></div>
            </div>

            <div class="actions-bar">
                <button class="add-btn" id="addModuleBtn"><span>+</span> Создать модуль</button>
                <div class="search-box"><input type="text" id="searchInput" placeholder="🔍 Поиск модулей..." class="search-input"></div>
            </div>

            <div class="content-tree" id="contentTree"><div class="loading-spinner"><div class="spinner"></div><p>Загрузка...</p></div></div>
        </main>
    </div>

    <!-- Модальное окно для модуля -->
    <div class="modal-overlay" id="moduleModal" style="display: none;">
        <div class="modal-container">
            <div class="modal-header"><h3 id="moduleModalTitle">Создание модуля</h3><button class="modal-close" id="closeModuleModalBtn">&times;</button></div>
            <div class="modal-body">
                <div class="form-group"><label>Номер модуля *</label><input type="number" id="moduleNumber" class="form-input" placeholder="1"></div>
                <div class="form-group"><label>Название *</label><input type="text" id="moduleTitle" class="form-input" placeholder="Например: Основы аддитивных технологий"></div>
                <div class="form-group"><label>Описание</label><textarea id="moduleDescription" class="form-textarea" rows="3" placeholder="Краткое описание модуля..."></textarea></div>
                <div class="form-group"><label>Уровень сложности</label><select id="moduleDifficulty" class="form-select"><option value="1">Начинающий</option><option value="2">Средний</option><option value="3">Продвинутый</option></select></div>
                <div class="form-group checkbox-group"><label><input type="checkbox" id="modulePublished" checked> Опубликован</label></div>
            </div>
            <div class="modal-footer"><button class="modal-cancel-btn" id="cancelModuleBtn">Отмена</button><button class="modal-save-btn" id="saveModuleBtn">Сохранить</button></div>
        </div>
    </div>

    <!-- Модальное окно для урока (расширенное) -->
    <div class="modal-overlay" id="lessonModal" style="display: none;">
        <div class="modal-container wide">
            <div class="modal-header"><h3 id="lessonModalTitle">Создание урока</h3><button class="modal-close" id="closeLessonModalBtn">&times;</button></div>
            <div class="modal-body">
                <div class="form-group"><label>Название *</label><input type="text" id="lessonTitle" class="form-input" placeholder="Например: Введение в 3D-печать"></div>
                <div class="form-group"><label>Описание</label><textarea id="lessonDescription" class="form-textarea" rows="2" placeholder="Краткое описание урока..."></textarea></div>
                <div class="form-group"><label>Порядковый номер</label><input type="number" id="lessonOrder" class="form-input" placeholder="1"><div class="error-hint" id="lessonOrderError" style="display: none;">⚠️ Этот номер урока уже занят в данном модуле</div></div>
                <div class="form-group">
                    <label>Теоретический материал</label>
                        <textarea id="lessonTheory" class="form-textarea large-textarea" rows="12" placeholder="HTML-текст с теорией..."></textarea>
                        <small class="form-hint">Поддерживается HTML-разметка</small>
                    </div>   
                </div>
            <div class="modal-footer"><button class="modal-cancel-btn" id="cancelLessonBtn">Отмена</button><button class="modal-save-btn" id="saveLessonBtn">Сохранить</button></div>
        </div>
    </div>

    <!-- Модальное окно для задания (с расширенным редактированием) -->
    <div class="modal-overlay" id="taskModal" style="display: none;">
        <div class="modal-container extra-wide">
            <div class="modal-header"><h3 id="taskModalTitle">Создание задания</h3><button class="modal-close" id="closeTaskModalBtn">&times;</button></div>
            <div class="modal-body">
                <div class="form-row">
                    <div class="form-group"><label>Тип задания *</label><select id="taskType" class="form-select"><option value="Тест">📝 Тест</option><option value="Сопоставление">🔄 Сопоставление</option><option value="Квест">🗺️ Квест</option></select></div>
                    <div class="form-group"><label>Уровень сложности</label><select id="taskDifficulty" class="form-select"><option value="1">Легкий</option><option value="2">Средний</option><option value="3">Сложный</option></select></div>
                    <div class="form-group"><label>Макс. баллов</label><input type="number" id="taskMaxScore" class="form-input" value="100"></div>
                </div>
                <div class="form-group"><label>Название *</label><input type="text" id="taskTitle" class="form-input" placeholder="Например: Тест: Основы АТ"></div>
                <div class="form-group"><label>Описание</label><textarea id="taskDescription" class="form-textarea" rows="2" placeholder="Инструкция для студента..."></textarea></div>
                <div class="form-group checkbox-group"><label><input type="checkbox" id="taskActive" checked> Активно (доступно студентам)</label></div>

                <!-- Блок для теста -->
                <div id="testEditorBlock" class="content-editor-block" style="display: none;">
                    <div class="section-divider"><span>📝 Вопросы теста</span><button class="inline-add-btn" id="addQuestionBtn">+ Добавить вопрос</button></div>
                    <div id="questionsList" class="sortable-list"></div>
                </div>

                <!-- Блок для сопоставления -->
                <div id="matchingEditorBlock" class="content-editor-block" style="display: none;">
                    <div class="section-divider"><span>🔄 Пары для сопоставления</span><button class="inline-add-btn" id="addPairBtn">+ Добавить пару</button></div>
                    <div id="pairsList" class="sortable-list"></div>
                </div>

                <!-- Блок для квеста -->
                <div id="questEditorBlock" class="content-editor-block" style="display: none;">
                    <div class="section-divider"><span>🗺️ Этапы квеста</span><button class="inline-add-btn" id="addStageBtn">+ Добавить этап</button></div>
                    <div id="stagesList" class="sortable-list"></div>
                </div>
            </div>
            <div class="modal-footer"><button class="modal-cancel-btn" id="cancelTaskBtn">Отмена</button><button class="modal-save-btn" id="saveTaskBtn">Сохранить задание</button></div>
        </div>
    </div>

    <!-- Модальное окно подтверждения удаления -->
    <div class="modal-overlay" id="deleteModal" style="display: none;">
        <div class="modal-container small">
            <div class="modal-header"><h3>Подтверждение удаления</h3><button class="modal-close" id="closeDeleteModalBtn">&times;</button></div>
            <div class="modal-body"><p>Вы уверены, что хотите удалить этот элемент?</p><p class="delete-warning">Это действие нельзя отменить.</p></div>
            <div class="modal-footer"><button class="modal-cancel-btn" id="cancelDeleteBtn">Отмена</button><button class="modal-confirm-btn" id="confirmDeleteBtn">Удалить</button></div>
        </div>
    </div>

    <script>
        let currentUser = null;
        let modules = [];
        let editingModuleId = null;
        let editingLessonId = null;
        let editingTaskId = null;
        let currentModuleId = null;
        let currentLessonId = null;
        let deleteType = null;
        let deleteId = null;
        let deleteQuestionId = null;
        let deleteQuestionIndex = null;
        let searchQuery = '';

        let currentQuestions = [];
        let currentPairs = [];
        let currentStages = [];

        function loadUserData() {
            const user = JSON.parse(localStorage.getItem('user'));
            if (!user) { window.location.href = '/Home/Login'; return null; }
            if (user.roleId !== 4) { window.location.href = '/Home/Courses'; return null; }
            document.getElementById('userName').textContent = user.firstName + ' ' + user.lastName;
            return user;
        }

        async function loadStats() {
            try {
                const response = await fetch('/api/admin/content/stats');
                const stats = await response.json();
                document.getElementById('modulesCount').textContent = stats.modulesCount || 0;
                document.getElementById('lessonsCount').textContent = stats.lessonsCount || 0;
                document.getElementById('tasksCount').textContent = stats.tasksCount || 0;
                document.getElementById('activeTasksCount').textContent = stats.activeTasksCount || 0;
            } catch (error) { console.error(error); }
        }

        async function loadContent() {
            try {
                const response = await fetch('/api/admin/content/modules');
                modules = await response.json();
                applyFiltersAndRender();
                await loadStats();
            } catch (error) {
                document.getElementById('contentTree').innerHTML = '<div class="error-message">⚠️ Ошибка загрузки данных</div>';
            }
        }

        function applyFiltersAndRender() {
            let filtered = [...modules];
            if (searchQuery.trim()) {
                const query = searchQuery.trim().toLowerCase();
                filtered = filtered.filter(m => m.moduleTitle && m.moduleTitle.toLowerCase().includes(query));
            }
            renderContentTree(filtered);
        }

        function getDifficultyText(level) {
            if (level === 1) return 'Начинающий';
            if (level === 2) return 'Средний';
            return 'Продвинутый';
        }

        function getDifficultyClass(level) {
            if (level === 1) return 'easy';
            if (level === 2) return 'medium';
            return 'hard';
        }

        function getTaskIcon(typeName) {
            if (typeName === 'Тест') return '📝';
            if (typeName === 'Сопоставление') return '🔄';
            if (typeName === 'Квест') return '🗺️';
            return '📌';
        }

        function renderContentTree(items) {
            const container = document.getElementById('contentTree');
            if (!items.length) {
                container.innerHTML = '<div class="empty-message">📭 Нет модулей. Создайте первый модуль!</div>';
                return;
            }

            let html = '<div class="modules-tree">';
            for (let i = 0; i < items.length; i++) {
                const module = items[i];
                let lessonsHtml = '';

                if (module.lessons && module.lessons.length) {
                    for (let j = 0; j < module.lessons.length; j++) {
                        const lesson = module.lessons[j];
                        let tasksHtml = '';

                        if (lesson.tasks && lesson.tasks.length) {
                            for (let k = 0; k < lesson.tasks.length; k++) {
                                const task = lesson.tasks[k];
                                tasksHtml += `<div class="tree-task">
                                    <div class="task-info">
                                        <span class="task-icon">${getTaskIcon(task.typeName)}</span>
                                        <span class="task-title">${escapeHtml(task.taskTitle)}</span>
                                        <span class="task-score">${task.maxScore} XP</span>
                                        ${task.isActive ? '<span class="badge-active">Активен</span>' : '<span class="badge-inactive">Неактивен</span>'}
                                    </div>
                                    <div class="task-actions">
                                        <button class="action-btn edit-task" data-module-id="${module.moduleId}" data-lesson-id="${lesson.lessonId}" data-task-id="${task.taskId}" title="Редактировать задание">✏️</button>
                                        <button class="action-btn delete-task" data-module-id="${module.moduleId}" data-lesson-id="${lesson.lessonId}" data-task-id="${task.taskId}" title="Удалить задание">🗑️</button>
                                    </div>
                                </div>`;
                            }
                        }

                        tasksHtml += `<div class="tree-add-task"><button class="add-task-btn" data-module-id="${module.moduleId}" data-lesson-id="${lesson.lessonId}">+ Добавить задание</button></div>`;

                        lessonsHtml += `<div class="tree-lesson">
                            <div class="lesson-header">
                                <div class="lesson-info"><span class="lesson-order">Урок ${lesson.lessonOrder}</span><span class="lesson-title">${escapeHtml(lesson.lessonTitle)}</span></div>
                                <div class="lesson-actions">
                                    <button class="action-btn edit-lesson" data-module-id="${module.moduleId}" data-lesson-id="${lesson.lessonId}" title="Редактировать урок">✏️</button>
                                    <button class="action-btn delete-lesson" data-module-id="${module.moduleId}" data-lesson-id="${lesson.lessonId}" title="Удалить урок">🗑️</button>
                                </div>
                            </div>
                            <div class="lesson-tasks">${tasksHtml}</div>
                        </div>`;
                    }
                }

                lessonsHtml += `<div class="tree-add-lesson"><button class="add-lesson-btn" data-module-id="${module.moduleId}">+ Добавить урок</button></div>`;
                const publishStatus = module.isPublished ? '<span class="published-badge">Опубликован</span>' : '<span class="draft-badge">Скрыт</span>';

                html += `<div class="tree-module">
                    <div class="module-header" data-module-id="${module.moduleId}">
                        <div class="module-info">
                            <span class="module-expand-icon" data-module-id="${module.moduleId}">▼</span>
                            <div class="module-number-panel">Модуль ${module.moduleNumber}</div>
                            <div class="module-details">
                                <div class="module-title">${escapeHtml(module.moduleTitle)}</div>
                                <div class="module-meta">
                                    <span class="difficulty-tag ${getDifficultyClass(module.difficultyLevel)}">${getDifficultyText(module.difficultyLevel)}</span>
                                    ${publishStatus}
                                </div>
                            </div>
                        </div>
                        <div class="module-actions">
                            <button class="action-btn edit-module" data-module-id="${module.moduleId}" title="Редактировать модуль">✏️</button>
                            <button class="action-btn delete-module" data-module-id="${module.moduleId}" title="Удалить модуль">🗑️</button>
                        </div>
                    </div>
                    <div class="module-lessons" data-module-id="${module.moduleId}">
                        ${lessonsHtml}
                    </div>
                </div>`;
            }
            html += '</div>';
            container.innerHTML = html;

            // Обработчики для сворачивания модулей
            document.querySelectorAll('.module-header').forEach(header => {
                const moduleId = header.dataset.moduleId;
                const lessonsDiv = document.querySelector(`.module-lessons[data-module-id="${moduleId}"]`);
                const expandIcon = header.querySelector('.module-expand-icon');
                
                const isCollapsed = localStorage.getItem(`module_${moduleId}_collapsed`) === 'true';
                if (isCollapsed && lessonsDiv) {
                    lessonsDiv.classList.add('collapsed');
                    if (expandIcon) expandIcon.classList.add('collapsed');
                }
                
                header.addEventListener('click', (e) => {
                    if (e.target.classList.contains('action-btn') || e.target.closest('.module-actions')) return;
                    
                    if (lessonsDiv) {
                        lessonsDiv.classList.toggle('collapsed');
                        if (expandIcon) expandIcon.classList.toggle('collapsed');
                        localStorage.setItem(`module_${moduleId}_collapsed`, lessonsDiv.classList.contains('collapsed'));
                    }
                });
            });

            document.querySelectorAll('.edit-module').forEach(btn => btn.addEventListener('click', (e) => {
                e.stopPropagation();
                editModule(parseInt(btn.dataset.moduleId));
            }));
            document.querySelectorAll('.delete-module').forEach(btn => btn.addEventListener('click', (e) => {
                e.stopPropagation();
                showDeleteModal('module', parseInt(btn.dataset.moduleId));
            }));
            document.querySelectorAll('.edit-lesson').forEach(btn => btn.addEventListener('click', () => editLesson(parseInt(btn.dataset.moduleId), parseInt(btn.dataset.lessonId))));
            document.querySelectorAll('.delete-lesson').forEach(btn => btn.addEventListener('click', () => showDeleteModal('lesson', parseInt(btn.dataset.lessonId))));
            document.querySelectorAll('.edit-task').forEach(btn => btn.addEventListener('click', () => editTask(parseInt(btn.dataset.taskId), parseInt(btn.dataset.lessonId), parseInt(btn.dataset.moduleId))));
            document.querySelectorAll('.delete-task').forEach(btn => btn.addEventListener('click', () => showDeleteModal('task', parseInt(btn.dataset.taskId))));
            document.querySelectorAll('.add-lesson-btn').forEach(btn => btn.addEventListener('click', (e) => {
                e.stopPropagation();
                showAddLesson(parseInt(btn.dataset.moduleId));
            }));
            document.querySelectorAll('.add-task-btn').forEach(btn => btn.addEventListener('click', (e) => {
                e.stopPropagation();
                showAddTask(parseInt(btn.dataset.lessonId), parseInt(btn.dataset.moduleId));
            }));
        }

        function showAddModule() {
            editingModuleId = null;
            document.getElementById('moduleModalTitle').textContent = 'Создание модуля';
            document.getElementById('moduleNumber').value = modules.length + 1;
            document.getElementById('moduleTitle').value = '';
            document.getElementById('moduleDescription').value = '';
            document.getElementById('moduleDifficulty').value = '1';
            document.getElementById('modulePublished').checked = true;
            document.getElementById('moduleModal').style.display = 'flex';
            document.body.classList.add('modal-open');
        }

        function editModule(moduleId) {
            const module = modules.find(m => m.moduleId === moduleId);
            if (module) {
                editingModuleId = moduleId;
                document.getElementById('moduleModalTitle').textContent = 'Редактирование модуля';
                document.getElementById('moduleNumber').value = module.moduleNumber;
                document.getElementById('moduleTitle').value = module.moduleTitle;
                document.getElementById('moduleDescription').value = module.moduleDescription || '';
                document.getElementById('moduleDifficulty').value = module.difficultyLevel;
                document.getElementById('modulePublished').checked = module.isPublished;
                document.getElementById('moduleModal').style.display = 'flex';
                document.body.classList.add('modal-open');
            }
        }

        async function saveModule() {
            const data = {
                moduleNumber: parseInt(document.getElementById('moduleNumber').value),
                moduleTitle: document.getElementById('moduleTitle').value.trim(),
                moduleDescription: document.getElementById('moduleDescription').value.trim(),
                difficultyLevel: parseInt(document.getElementById('moduleDifficulty').value),
                isPublished: document.getElementById('modulePublished').checked
            };
            if (!data.moduleTitle) { showToast('Введите название модуля'); return; }
            try {
                const url = editingModuleId ? `/api/admin/content/modules/${editingModuleId}` : '/api/admin/content/modules';
                const method = editingModuleId ? 'PUT' : 'POST';
                const response = await fetch(url, { method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
                if (response.ok) {
                    const actionText = editingModuleId ? `Изменён модуль "${data.moduleTitle}"` : `Создан модуль "${data.moduleTitle}"`;
                    if (typeof window.addAdminAction === 'function') {
                        window.addAdminAction('📚', actionText);
                    }
                    showToast(editingModuleId ? 'Модуль обновлён' : 'Модуль создан');
                    document.getElementById('moduleModal').style.display = 'none';
                    document.body.classList.remove('modal-open');
                    loadContent();
                } else showToast('Ошибка при сохранении');
            } catch (error) { showToast('Произошла ошибка'); }
        }

        function showAddLesson(moduleId) {
            currentModuleId = moduleId;
            editingLessonId = null;
            document.getElementById('lessonModalTitle').textContent = 'Создание урока';
            document.getElementById('lessonTitle').value = '';
            document.getElementById('lessonDescription').value = '';
            document.getElementById('lessonOrder').value = '';
            document.getElementById('lessonTheory').value = '';
            document.getElementById('lessonOrderError').style.display = 'none';
            document.getElementById('lessonModal').style.display = 'flex';
            document.body.classList.add('modal-open');
        }

        function editLesson(moduleId, lessonId) {
            currentModuleId = moduleId;
            editingLessonId = lessonId;
            const module = modules.find(m => m.moduleId === moduleId);
            const lesson = module.lessons.find(l => l.lessonId === lessonId);
            if (lesson) {
                document.getElementById('lessonModalTitle').textContent = 'Редактирование урока';
                document.getElementById('lessonTitle').value = lesson.lessonTitle;
                document.getElementById('lessonDescription').value = lesson.lessonDescription || '';
                document.getElementById('lessonOrder').value = lesson.lessonOrder;
                document.getElementById('lessonTheory').value = lesson.theoryContent || '';
                document.getElementById('lessonOrderError').style.display = 'none';
                document.getElementById('lessonModal').style.display = 'flex';
                document.body.classList.add('modal-open');
            }
        }

        function checkLessonOrder() {
            const orderValue = parseInt(document.getElementById('lessonOrder').value);
            if (isNaN(orderValue)) return false;
            const module = modules.find(m => m.moduleId === currentModuleId);
            if (!module) return false;
            const existingOrders = module.lessons.filter(l => l.lessonId !== editingLessonId).map(l => l.lessonOrder);
            if (existingOrders.includes(orderValue)) {
                document.getElementById('lessonOrderError').style.display = 'block';
                return false;
            } else {
                document.getElementById('lessonOrderError').style.display = 'none';
                return true;
            }
        }

        async function saveLesson() {
            if (!checkLessonOrder()) { showToast('Номер урока уже занят, выберите другой'); return; }
            const data = {
                moduleId: currentModuleId,
                lessonTitle: document.getElementById('lessonTitle').value.trim(),
                lessonDescription: document.getElementById('lessonDescription').value.trim(),
                lessonOrder: parseInt(document.getElementById('lessonOrder').value) || 1,
                theoryContent: document.getElementById('lessonTheory').value
            };
            if (!data.lessonTitle) { showToast('Введите название урока'); return; }
            try {
                const url = editingLessonId ? `/api/admin/content/lessons/${editingLessonId}` : '/api/admin/content/lessons';
                const method = editingLessonId ? 'PUT' : 'POST';
                const response = await fetch(url, { method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
                if (response.ok) {
