                url = `/api/admin/content/modules/${deleteId}`;
                const module = modules.find(m => m.moduleId === deleteId);
                actionText = `Удалён модуль "${module?.moduleTitle || '#' + deleteId}"`;
                icon = '📚';
            }
            else if (deleteType === 'lesson') {
                url = `/api/admin/content/lessons/${deleteId}`;
                let lessonTitle = '';
                for (const m of modules) {
                    const lesson = m.lessons?.find(l => l.lessonId === deleteId);
                    if (lesson) {
                        lessonTitle = lesson.lessonTitle;
                        break;
                    }
                }
                actionText = `Удалён урок "${lessonTitle || '#' + deleteId}"`;
                icon = '📖';
            }
            else if (deleteType === 'task') {
                url = `/api/admin/content/tasks/${deleteId}`;
                let taskTitle = '';
                for (const m of modules) {
                    for (const l of (m.lessons || [])) {
                        const task = l.tasks?.find(t => t.taskId === deleteId);
                        if (task) {
                            taskTitle = task.taskTitle;
                            break;
                        }
                    }
                }
                actionText = `Удалено задание "${taskTitle || '#' + deleteId}"`;
                icon = '📝';
            }
            
            try {
                const response = await fetch(url, { method: 'DELETE' });
                if (response.ok) { 
                    if (typeof window.addAdminAction === 'function') {
                        window.addAdminAction(icon, actionText);
                    }
                    showToast('Элемент удалён'); 
                    document.getElementById('deleteModal').style.display = 'none'; 
                    document.body.classList.remove('modal-open'); 
                    loadContent(); 
                }
                else showToast('Ошибка при удалении');
            } catch (error) { showToast('Произошла ошибка'); }
        }

        function showToast(message) {
            const toast = document.createElement('div');
            toast.className = 'toast-message';
            toast.textContent = message;
            document.body.appendChild(toast);
            setTimeout(() => toast.remove(), 3000);
        }

        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/[&<>]/g, m => { if (m === '&') return '&amp;'; if (m === '<') return '&lt;'; if (m === '>') return '&gt;'; return m; });
        }

        document.getElementById('searchInput')?.addEventListener('input', e => { searchQuery = e.target.value; applyFiltersAndRender(); });
        document.getElementById('addModuleBtn')?.addEventListener('click', showAddModule);
        document.getElementById('addQuestionBtn')?.addEventListener('click', showAddQuestionInPlace);
        document.getElementById('addPairBtn')?.addEventListener('click', showAddPairInPlace);
        document.getElementById('addStageBtn')?.addEventListener('click', showAddStageInPlace);
        document.getElementById('taskType')?.addEventListener('change', e => toggleTaskTypeEditor(e.target.value));
        
        const profileBtn = document.getElementById('profileBtn'), profileDropdown = document.getElementById('profileDropdown');
        let dropdownTimeout;
        if (profileBtn && profileDropdown) {
            profileBtn.addEventListener('mouseenter', () => { clearTimeout(dropdownTimeout); profileDropdown.classList.add('show'); });
            profileBtn.addEventListener('mouseleave', () => { dropdownTimeout = setTimeout(() => profileDropdown.classList.remove('show'), 200); });
            profileDropdown.addEventListener('mouseenter', () => { clearTimeout(dropdownTimeout); profileDropdown.classList.add('show'); });
            profileDropdown.addEventListener('mouseleave', () => { dropdownTimeout = setTimeout(() => profileDropdown.classList.remove('show'), 200); });
        }
        document.getElementById('profileSettingsBtn')?.addEventListener('click', () => window.location.href = '/Admin/Profile');
        document.getElementById('dashboardBtn')?.addEventListener('click', () => window.location.href = '/Admin/Dashboard');
        document.getElementById('logoutBtn')?.addEventListener('click', () => { localStorage.removeItem('user'); window.location.href = '/Home/Index'; });
        
        function closeModals() {
            document.getElementById('moduleModal').style.display = 'none';
            document.getElementById('lessonModal').style.display = 'none';
            document.getElementById('taskModal').style.display = 'none';
            document.getElementById('deleteModal').style.display = 'none';
            document.body.classList.remove('modal-open');
        }
        
        document.getElementById('closeModuleModalBtn')?.addEventListener('click', closeModals);
        document.getElementById('cancelModuleBtn')?.addEventListener('click', closeModals);
        document.getElementById('saveModuleBtn')?.addEventListener('click', saveModule);
        document.getElementById('closeLessonModalBtn')?.addEventListener('click', closeModals);
        document.getElementById('cancelLessonBtn')?.addEventListener('click', closeModals);
        document.getElementById('saveLessonBtn')?.addEventListener('click', saveLesson);
        document.getElementById('closeTaskModalBtn')?.addEventListener('click', closeModals);
        document.getElementById('cancelTaskBtn')?.addEventListener('click', closeModals);
        document.getElementById('saveTaskBtn')?.addEventListener('click', saveTask);
        document.getElementById('closeDeleteModalBtn')?.addEventListener('click', closeModals);
        document.getElementById('cancelDeleteBtn')?.addEventListener('click', closeModals);
        
        // Обновляем обработчик кнопки подтверждения удаления
        const confirmDeleteBtn = document.getElementById('confirmDeleteBtn');
        if (confirmDeleteBtn) {
            const newConfirmBtn = confirmDeleteBtn.cloneNode(true);
            confirmDeleteBtn.parentNode.replaceChild(newConfirmBtn, confirmDeleteBtn);
            newConfirmBtn.addEventListener('click', () => {
                if (deleteQuestionId !== null && deleteQuestionIndex !== null) {
                    deleteQuestionConfirmed();
                } else if (deleteStageId !== null && deleteStageIndex !== null) {
                    deleteStageConfirmed();
                } else {
                    deleteItem();
                }
            });
        }
        
        window.addEventListener('click', e => { 
            if (e.target.classList.contains('modal-overlay')) { 
                closeModals();
            } 
        });
        
        currentUser = loadUserData();
        if (currentUser) {
            loadContent();
        }
        document.getElementById('backToDashboardBtn')?.addEventListener('click', () => {
            window.location.href = '/Admin/Dashboard';
        });
    </script>
</body>
</html>