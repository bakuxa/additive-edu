        function attachQuestEditorHandlers(container) {
            // Обработчики для single_choice и multiple_choice
            container.querySelectorAll('.remove-option')?.forEach(btn => {
                btn.addEventListener('click', (e) => {
                    const idx = parseInt(btn.dataset.optIndex);
                    editingStageDataGlobal.options.splice(idx, 1);
                    if (editingStageDataGlobal.type === 'single_choice') {
                        if (editingStageDataGlobal.correctAnswer === idx) editingStageDataGlobal.correctAnswer = 0;
                        else if (editingStageDataGlobal.correctAnswer > idx) editingStageDataGlobal.correctAnswer--;
                    }
                    if (editingStageDataGlobal.type === 'multiple_choice') {
                        editingStageDataGlobal.correctAnswers = editingStageDataGlobal.correctAnswers.filter(i => i !== idx).map(i => i > idx ? i - 1 : i);
                    }
                    const editorDiv = container.querySelector('#questTypeSpecificEditor');
                    if (editorDiv) editorDiv.innerHTML = renderQuestTypeEditorByType();
                    attachQuestEditorHandlers(container);
                });
            });
            
            container.querySelector('.add-option-btn')?.addEventListener('click', () => {
                editingStageDataGlobal.options.push('');
                if (editingStageDataGlobal.type === 'multiple_choice') {
                    editingStageDataGlobal.correctAnswers.push(editingStageDataGlobal.options.length - 1);
                }
                const editorDiv = container.querySelector('#questTypeSpecificEditor');
                if (editorDiv) editorDiv.innerHTML = renderQuestTypeEditorByType();
                attachQuestEditorHandlers(container);
            });
            
            container.querySelectorAll('.option-text')?.forEach(input => {
                input.addEventListener('change', (e) => {
                    const idx = parseInt(input.dataset.optIndex);
                    editingStageDataGlobal.options[idx] = input.value;
                });
            });
            
            container.querySelectorAll('input[name="correct_option"]')?.forEach(radio => {
                radio.addEventListener('change', (e) => {
                    editingStageDataGlobal.correctAnswer = parseInt(radio.value);
                });
            });
            
            container.querySelectorAll('.correct-checkbox')?.forEach(cb => {
                cb.addEventListener('change', (e) => {
                    const val = parseInt(cb.value);
                    if (cb.checked) {
                        if (!editingStageDataGlobal.correctAnswers.includes(val)) editingStageDataGlobal.correctAnswers.push(val);
                    } else {
                        editingStageDataGlobal.correctAnswers = editingStageDataGlobal.correctAnswers.filter(i => i !== val);
                    }
                });
            });
            
            container.querySelector('.true-false-select')?.addEventListener('change', (e) => {
                editingStageDataGlobal.correctAnswer = e.target.value === 'true';
            });
            
            container.querySelector('.correct-answer-input')?.addEventListener('change', (e) => {
                editingStageDataGlobal.correctAnswer = e.target.value;
            });
            
            container.querySelector('.alternatives-input')?.addEventListener('change', (e) => {
                editingStageDataGlobal.alternatives = e.target.value.split(',').map(s => s.trim()).filter(s => s);
            });
            
            container.querySelectorAll('.remove-sequence-item')?.forEach(btn => {
                btn.addEventListener('click', (e) => {
                    const idx = parseInt(btn.dataset.seqIndex);
                    editingStageDataGlobal.items.splice(idx, 1);
                    const editorDiv = container.querySelector('#questTypeSpecificEditor');
                    if (editorDiv) editorDiv.innerHTML = renderQuestTypeEditorByType();
                    attachQuestEditorHandlers(container);
                });
            });
            
            container.querySelector('.add-sequence-btn')?.addEventListener('click', () => {
                editingStageDataGlobal.items.push('');
                const editorDiv = container.querySelector('#questTypeSpecificEditor');
                if (editorDiv) editorDiv.innerHTML = renderQuestTypeEditorByType();
                attachQuestEditorHandlers(container);
            });
            
            container.querySelectorAll('.sequence-item-text')?.forEach(input => {
                input.addEventListener('change', (e) => {
                    const idx = parseInt(input.dataset.seqIndex);
                    editingStageDataGlobal.items[idx] = input.value;
                });
            });
        }
        
        function buildStageDataFromGlobal() {
            const baseData = {
                type: editingStageDataGlobal.type,
                points: editingStageDataGlobal.points,
                question: editingStageDataGlobal.question
            };
            
            if (editingStageDataGlobal.hint) baseData.hint = editingStageDataGlobal.hint;
            
            switch(editingStageDataGlobal.type) {
                case 'single_choice':
                    return {
                        ...baseData,
                        options: editingStageDataGlobal.options.filter(opt => opt.trim()),
                        correctAnswer: editingStageDataGlobal.correctAnswer
                    };
                case 'multiple_choice':
                    return {
                        ...baseData,
                        options: editingStageDataGlobal.options.filter(opt => opt.trim()),
                        correctAnswers: editingStageDataGlobal.correctAnswers
                    };
                case 'true_false':
                    return {
                        ...baseData,
                        correctAnswer: editingStageDataGlobal.correctAnswer
                    };
                case 'text_input':
                case 'fill_blank':
                    const result = {
                        ...baseData,
                        correctAnswer: editingStageDataGlobal.correctAnswer
                    };
                    if (editingStageDataGlobal.alternatives.length) {
                        result.alternatives = editingStageDataGlobal.alternatives;
                    }
                    return result;
                case 'sequence':
                    const validItems = editingStageDataGlobal.items.filter(item => item.trim());
                    return {
                        ...baseData,
                        items: validItems,
                        correctOrder: validItems.map((_, idx) => idx)
                    };
                default:
                    return baseData;
            }
        }

