       async function saveMatchingToServer(taskId) {
    if (!taskId) {
        console.error('Нет taskId для сохранения сопоставления');
        return false;
    }
    
    // Убираем пустые пары
    const validPairs = currentPairs.filter(p => 
        p.leftText && p.leftText.trim() && p.rightText && p.rightText.trim()
    );
    
    const leftItems = validPairs.map(p => p.leftText.trim());
    const rightItems = validPairs.map(p => p.rightText.trim());
    const correctMatches = validPairs.map((p, idx) => ({ left: idx, right: idx }));
    const maxScore = parseInt(document.getElementById('taskMaxScore').value);
    
    const data = {
        leftItems: leftItems,
        rightItems: rightItems,
        correctMatches: correctMatches,
        maxScore: maxScore
    };
    
    console.log('Сохранение сопоставления для taskId:', taskId, data);
    
    try {
        const response = await fetch(`/api/admin/content/matching/by-task/${taskId}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        
        if (!response.ok) {
            const errorText = await response.text();
            console.error('Ошибка сохранения сопоставления:', errorText);
            showToast('Ошибка при сохранении пар сопоставления');
            return false;
        }
        return true;
    } catch (error) {
        console.error('Ошибка:', error);
        showToast('Произошла ошибка при сохранении сопоставления');
        return false;
    }
}

