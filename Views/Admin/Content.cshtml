        function editQuestionInPlace(questionId, index) {
    const question = currentQuestions[index];
    if (!question) return;
    
    const item = document.querySelector(`.sortable-item[data-index="${index}"]`);
    if (!item) return;
    
    const answersHtml = (question.answers || []).map((ans, ansIdx) => `
        <div class="inline-answer">
            <input type="text" class="inline-answer-text" value="${escapeHtml(ans.answerText)}" placeholder="Вариант ответа" data-ans-index="${ansIdx}">
            <label class="inline-correct"><input type="radio" name="correct_answer_${index}" value="${ansIdx}" ${ans.isCorrect ? 'checked' : ''}> Верно</label>
            <button type="button" class="action-btn remove-answer" data-ans-index="${ansIdx}">🗑️</button>
        </div>
    `).join('');
    
    const editHtml = `
        <div class="inline-editor">
            <div class="inline-editor-field">
                <label>Текст вопроса</label>
                <textarea class="question-text-input" rows="2">${escapeHtml(question.questionText)}</textarea>
            </div>
            <div class="inline-editor-row">
                <div class="inline-editor-field"><label>Уровень</label><select class="question-level"><option value="1" ${question.questionLevel === 1 ? 'selected' : ''}>Легкий</option><option value="2" ${question.questionLevel === 2 ? 'selected' : ''}>Средний</option><option value="3" ${question.questionLevel === 3 ? 'selected' : ''}>Сложный</option></select></div>
                <div class="inline-editor-field"><label>Вес (баллы)</label><input type="number" class="question-weight" value="${question.questionWeight}"></div>
            </div>
            <div class="inline-editor-field"><label>Варианты ответов</label><div class="answers-editor">${answersHtml}</div><button type="button" class="inline-add-answer">+ Добавить вариант</button></div>
            <div class="inline-editor-buttons"><button type="button" class="save-question-inline">✓ Сохранить</button><button type="button" class="cancel-question-inline">✗ Отмена</button></div>
        </div>
    `;
    
    const contentDiv = item.querySelector('.sortable-content');
    const originalContent = contentDiv.innerHTML;
    contentDiv.innerHTML = editHtml;
    
    // Функция для сбора данных из редактора
    const collectDataFromEditor = () => {
        question.questionText = contentDiv.querySelector('.question-text-input').value;
        question.questionLevel = parseInt(contentDiv.querySelector('.question-level').value);
        question.questionWeight = parseInt(contentDiv.querySelector('.question-weight').value);
        
        // Собираем ответы
        const answerInputs = contentDiv.querySelectorAll('.inline-answer-text');
        const radioButtons = contentDiv.querySelectorAll('input[type="radio"]');
        const newAnswers = [];
        
        answerInputs.forEach((input, i) => {
            const isChecked = radioButtons[i]?.checked || false;
            newAnswers.push({
                answerText: input.value,
                isCorrect: isChecked
            });
        });
        question.answers = newAnswers;
    };
    
    // Добавление варианта ответа
    const addAnswerBtn = contentDiv.querySelector('.inline-add-answer');
    if (addAnswerBtn) {
        addAnswerBtn.addEventListener('click', () => {
            question.answers.push({ answerText: '', isCorrect: false });
            editQuestionInPlace(questionId, index);
        });
    }
    
    // Удаление варианта ответа
    contentDiv.querySelectorAll('.remove-answer').forEach(btn => {
        btn.addEventListener('click', (e) => {
            const ansIdx = parseInt(btn.dataset.ansIndex);
            question.answers.splice(ansIdx, 1);
            editQuestionInPlace(questionId, index);
        });
    });
    
    // Сохранение
    contentDiv.querySelector('.save-question-inline')?.addEventListener('click', async () => {
        collectDataFromEditor(); // Синхронизируем данные из DOM в переменную question
        renderQuestionsList(); // Перерисовываем список
        showToast('Вопрос сохранён локально');
    });
    
    // Отмена
    contentDiv.querySelector('.cancel-question-inline')?.addEventListener('click', () => {
        contentDiv.innerHTML = originalContent;
    });
}

        async function saveQuestionToServer(question, index, questionId, taskId) {
    const actualTaskId = taskId || editingTaskId;
    
    if (!actualTaskId) {
        console.error('Нет taskId для сохранения вопроса');
        return false;
    }
    
    const questionData = {
        taskId: actualTaskId,
        questionText: question.questionText,
        questionLevel: question.questionLevel,
        questionOrder: index + 1,
        questionWeight: question.questionWeight,
        answers: question.answers
    };
    
    try {
        const url = questionId ? `/api/admin/content/questions/${questionId}` : '/api/admin/content/questions';
        const method = questionId ? 'PUT' : 'POST';
        const response = await fetch(url, { 
            method, 
            headers: { 'Content-Type': 'application/json' }, 
            body: JSON.stringify(questionData) 
        });
        const result = await response.json();
        if (response.ok && result.questionId) {
            question.questionId = result.questionId;
            return true;
        }
        return false;
    } catch (error) { 
        console.error('Ошибка сохранения вопроса:', error);
        return false;
    }
}

